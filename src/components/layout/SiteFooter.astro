---
import { Image } from "astro:assets";
import logoUrl from "../../assets/images/brand/sina-hotpot-logo-horizontal.svg?url";
import { brand, getPath, locations, type Locale } from "../../data/site";
import { copy } from "../../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const layoutLabels = t.layout;
const studioCredit = {
  href: "https://qiao-digital-studio-web.yrw.workers.dev/",
  label: "Qiao Digital Studio · 桥络数字",
};
const devGithub = {
  href: "https://github.com/lorenzoyang",
  label: "lorenzoyang",
};
const footerClasses = {
  footer: "page-band bg-ink-footer",
  footerInner:
    "mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1.2fr_1fr] lg:px-8",
  footerLogoFrame: "inline-flex rounded-md bg-paper px-3 py-2",
  footerLogo: "h-12 w-auto max-w-[14rem] object-contain sm:max-w-[18rem]",
  footerDescription: "mt-4 max-w-xl text-sm leading-6 text-paper-soft/72",
  footerLinksGrid: "grid gap-4 text-sm text-paper-soft/80 sm:grid-cols-2",
  footerHeading: "font-semibold text-white",
  footerLink: "focus-ring mt-2 block rounded-sm hover:text-white",
  footerLinkTight: "focus-ring mt-1 block rounded-sm hover:text-white",
  footerSocialText: "mt-1 text-paper-soft/80",
  footerSocialId: "font-medium text-paper-soft",
  footerCredit:
    "mx-auto max-w-7xl border-t border-white/10 px-4 py-5 text-xs leading-5 text-paper-soft/56 sm:px-6 lg:px-8",
  footerLegal: "mb-3 grid gap-1 text-paper-soft/64",
  footerCreditLink:
    "focus-ring rounded-sm font-medium text-paper-soft/80 underline decoration-gold/40 underline-offset-4 transition hover:text-white hover:decoration-gold",
  footerCreditRow:
    "flex flex-wrap items-center gap-x-3 gap-y-1",
  footerCreditSep:
    "hidden text-paper-soft/32 sm:inline",
};
---

<footer class={footerClasses.footer}>
  <div class={footerClasses.footerInner}>
    <div>
      <div class={footerClasses.footerLogoFrame}>
        <Image
          src={logoUrl}
          alt={brand.publicName}
          class={footerClasses.footerLogo}
          width="1378"
          height="372"
          loading="lazy"
        />
      </div>
      <p class={footerClasses.footerDescription}>
        {t.meta.description}
      </p>
    </div>
    <div class={footerClasses.footerLinksGrid}>
      <div>
        <p class={footerClasses.footerHeading}>{layoutLabels.contact}</p>
        <a class={footerClasses.footerLink} href={`mailto:${brand.email}`}>
          {brand.email}
        </a>
        <a class={footerClasses.footerLinkTight} href={brand.whatsappHref}>
          {brand.whatsapp}
        </a>
      </div>
      <div>
        <p class={footerClasses.footerHeading}>{layoutLabels.social}</p>
        <a
          class={footerClasses.footerLink}
          href={brand.instagram}
          target="_blank"
          rel="noreferrer">Instagram</a
        >
        <a
          class={footerClasses.footerLinkTight}
          href={brand.facebook}
          target="_blank"
          rel="noreferrer">Facebook</a
        >
        <div class="mt-2">
          {
            locations.map((location) => (
              <p class={footerClasses.footerSocialText}>
                WeChat {location.city}:{" "}
                <span class={footerClasses.footerSocialId}>
                  {location.wechatId}
                </span>
              </p>
            ))
          }
        </div>
        <a
          class={footerClasses.footerLinkTight}
          href={getPath(locale, "privacy")}>{t.nav.privacy}</a
        >
      </div>
    </div>
  </div>
  <div class={footerClasses.footerCredit}>
    <div class={footerClasses.footerLegal} aria-label="Informazioni legali">
      {brand.legal.footerLines.map((line) => <p>{line}</p>)}
    </div>
    <div class={footerClasses.footerCreditRow}>
      <p>
        Powered by{" "}
        <a
          class={footerClasses.footerCreditLink}
          href={studioCredit.href}
          target="_blank"
          rel="noreferrer">{studioCredit.label}</a
        >
      </p>
      <span class={footerClasses.footerCreditSep} aria-hidden="true">·</span>
      <p>
        <a
          class={footerClasses.footerCreditLink}
          href={devGithub.href}
          target="_blank"
          rel="noreferrer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" width="14" height="14" style="display:inline;vertical-align:-0.15em;margin-right:0.2em;"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>{" "}
          {devGithub.label}
        </a>
      </p>
    </div>
  </div>
</footer>
