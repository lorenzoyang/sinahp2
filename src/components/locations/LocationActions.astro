---
import CtaLink from "../ui/CtaLink.astro";
import { project } from "../../data/project";
import type { RestaurantLocation } from "../../data/site";

interface Props {
  location: RestaurantLocation;
  reservationHref: string;
  reservationLabel: string;
  officialWebsiteLabel: string;
  mapLabel: string;
  spacingClass?: "mt-5" | "mt-6";
}

const { location, reservationHref, reservationLabel, officialWebsiteLabel, mapLabel, spacingClass = "mt-5" } = Astro.props;
const layoutClasses = { root: "flex flex-col gap-3 sm:flex-row sm:flex-wrap" };
const actionClasses = { link: "w-full min-w-0 justify-center text-center sm:w-auto" };
---

<div class:list={[spacingClass, layoutClasses.root]}>
  <CtaLink href={reservationHref} variant="goldSmall" class={actionClasses.link}>
    {reservationLabel}
  </CtaLink>
  <CtaLink href={project.officialWebsite} variant="redSmall" class={actionClasses.link} external>
    {officialWebsiteLabel}
  </CtaLink>
  <CtaLink href={location.mapHref} variant="lightOutlineSmall" class={actionClasses.link} external>
    {mapLabel}
  </CtaLink>
</div>
