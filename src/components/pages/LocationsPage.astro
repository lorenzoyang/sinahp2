---
import SiteLayout from "../../layouts/SiteLayout.astro";
import LocationActions from "../locations/LocationActions.astro";
import LocationPhotoCarousel from "../locations/LocationPhotoCarousel.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { brand, getPath, locations, type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import { getPageSeoMeta } from "../../data/seo";
import {
  cardClasses as sharedCardClasses,
  headingClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const seoMeta = getPageSeoMeta(locale, "locations");
const socialImage = locations[0]?.image.src;
const reservationPath = getPath(locale, "reservation");
const sectionClasses = {
  hero: sharedSectionClasses.heroDark,
  listing: sharedSectionClasses.inkBandTight,
};
const cardClasses = {
  location: `overflow-hidden ${sharedCardClasses.paperPanel}`,
};
const layoutClasses = {
  listingGrid: "mx-auto grid max-w-7xl gap-5 lg:grid-cols-2",
  locationBody: "p-5 sm:p-6",
};
const textClasses = {
  label:
    "max-w-full break-words text-xs font-semibold uppercase leading-5 tracking-normal text-lacquer",
  city: "mt-3 text-3xl font-semibold",
  hours: "mt-2 text-sm",
  hoursLabel: "font-semibold text-lacquer",
  hoursValue: "ml-1 text-ink/80",
};

const restaurantInteriorLabels = {
  it: "interno del ristorante",
  zh: "门店室内环境",
  en: "restaurant interior",
  es: "interior del restaurante",
  fr: "intérieur du restaurant",
} as const satisfies Record<Locale, string>;

function formatA11yLabel(
  template: string,
  values: Record<string, string | number>,
) {
  return Object.entries(values).reduce(
    (label, [key, value]) => label.replaceAll(`{${key}}`, String(value)),
    template,
  );
}

const locationCards = locations.map((location) => ({
  ...location,
  whatsappMessage: formatA11yLabel(t.locations.whatsappMessage, {
    city: location.city,
  }),
  slides: location.gallery.map((photo, index) => {
    const number = index + 1;
    const photoLabel = formatA11yLabel(t.a11y.photoLabel, {
      city: location.city,
      number,
    });

    return {
      id: `location-${location.id}-photo-${number}`,
      photo,
      alt: `${brand.publicName} ${location.city} ${restaurantInteriorLabels[locale]} ${number}`,
      label: photoLabel,
    };
  }),
}));
---

<SiteLayout
  locale={locale}
  page="locations"
  title={seoMeta?.title}
  description={seoMeta?.description}
  socialImage={socialImage}
>
  <section class={sectionClasses.hero}>
    <SectionHeader
      eyebrow={t.locations.eyebrow}
      title={t.locations.title}
      intro={t.locations.intro}
      containerClass="mx-auto max-w-7xl"
      titleClass={headingClasses.heroTitle}
      introClass={headingClasses.heroIntro}
    />
  </section>

  <section class={sectionClasses.listing}>
    <div class={layoutClasses.listingGrid}>
      {
        locationCards.map((location) => (
          <article
            class={cardClasses.location}
            id={location.id}
            style="scroll-margin-top: 5rem;"
          >
            <LocationPhotoCarousel
              slides={location.slides}
              regionLabel={formatA11yLabel(t.a11y.restaurantPhotos, {
                city: location.city,
              })}
              roleDescription={t.a11y.carousel}
              trackLabel={formatA11yLabel(t.a11y.photoSlides, {
                city: location.city,
              })}
              navigationLabel={formatA11yLabel(t.a11y.photoNavigation, {
                city: location.city,
              })}
            />
            <div class={layoutClasses.locationBody}>
              <p class={textClasses.label}>{t.locations.daily}</p>
              <h2 class={textClasses.city}>{location.city}</h2>
              <p class={textClasses.hours}>
                <span class={textClasses.hoursLabel}>
                  {t.locations.hours}:
                </span>
                <span class={textClasses.hoursValue}>{location.hours}</span>
              </p>
              <LocationActions
                location={location}
                reservationHref={reservationPath}
                reservationLabel={t.cta.reserve}
                whatsappLabel={t.cta.whatsappReservation}
                phoneLabel={t.cta.phoneReservation}
                wechatLabel={t.cta.wechatReservation}
                copyWechatLabel={t.cta.copyWechat}
                copiedLabel={t.cta.copied}
                mapLabel={t.cta.map}
                whatsappMessage={location.whatsappMessage}
                spacingClass="mt-6"
              />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>

<script>
  import "../../scripts/locationCarousel";
  import "../../scripts/wechatCopy";
</script>
