---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { images, locations, type Locale } from "../../data/site";
import { copy } from "../../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<SiteLayout
  locale={locale}
  page="locations"
  title={`${t.locations.title} | Sina Hotpot`}
  description={t.locations.intro}
>
  <section class="bg-[#15110f] px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p
        class="text-xs font-semibold uppercase tracking-[0.28em] text-[#c7a062]"
      >
        {t.locations.eyebrow}
      </p>
      <h1
        class="mt-4 max-w-4xl text-4xl font-semibold leading-tight text-white sm:text-5xl"
      >
        {t.locations.title}
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-[#efe3d5]/82">
        {t.locations.intro}
      </p>
    </div>
  </section>

  <section class="page-band bg-[#211612] px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-5 lg:grid-cols-2">
      {
        locations.map((location, index) => (
          <article class="overflow-hidden rounded-lg border border-white/12 bg-[#f7f0e7] text-[#15110f]">
            <img
              src={index === 0 ? images.interior : images.platter}
              alt=""
              class="aspect-16/10 w-full object-cover"
              width="900"
              height="560"
              loading="lazy"
            />
            <div class="p-5 sm:p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#8f241d]">
                {t.locations.daily}
              </p>
              <h2 class="mt-3 text-3xl font-semibold">{location.city}</h2>
              <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-3">
                <div>
                  <dt class="font-semibold text-[#8f241d]">
                    {t.locations.address}
                  </dt>
                  <dd class="mt-1 leading-6">{location.address}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-[#8f241d]">
                    {t.locations.phone}
                  </dt>
                  <dd class="mt-1 leading-6">{location.phone}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-[#8f241d]">
                    {t.locations.hours}
                  </dt>
                  <dd class="mt-1 leading-6">{location.hours}</dd>
                </div>
              </dl>
              <div class="mt-6 flex flex-wrap gap-3">
                <a
                  class="focus-ring rounded-md bg-[#8f241d] px-4 py-2 text-sm font-semibold text-white"
                  href={`tel:${location.phone.replaceAll(" ", "")}`}
                >
                  {t.cta.call}
                </a>
                <a
                  class="focus-ring rounded-md border border-[#c7a062] px-4 py-2 text-sm font-semibold"
                  href={location.mapHref}
                  target="_blank"
                  rel="noreferrer"
                >
                  {t.cta.map}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>
