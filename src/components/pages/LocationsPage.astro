---
import SiteLayout from "../../layouts/SiteLayout.astro";
import LocationActions from "../LocationActions.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { locations, type Locale } from "../../data/site";
import { copy } from "../../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<SiteLayout
  locale={locale}
  page="locations"
  title={`${t.locations.title} | Sina Hotpot`}
  description={t.locations.intro}
>
  <section class="bg-ink px-4 py-12 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow={t.locations.eyebrow}
      title={t.locations.title}
      intro={t.locations.intro}
      containerClass="mx-auto max-w-7xl"
      titleClass="mt-4 max-w-4xl text-4xl font-semibold leading-tight text-white sm:text-5xl"
      introClass="mt-5 max-w-3xl text-lg leading-8 text-paper-soft/82"
    />
  </section>

  <section class="page-band bg-ink-band px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-5 lg:grid-cols-2">
      {
        locations.map((location) => (
          <article class="overflow-hidden rounded-lg border border-white/12 bg-paper text-ink">
            <img
              src={location.image}
              alt=""
              class="aspect-16/10 w-full object-cover"
              width="900"
              height="560"
              loading="lazy"
            />
            <div class="p-5 sm:p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-lacquer">
                {t.locations.daily}
              </p>
              <h2 class="mt-3 text-3xl font-semibold">{location.city}</h2>
              <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-3">
                <div>
                  <dt class="font-semibold text-lacquer">
                    {t.locations.address}
                  </dt>
                  <dd class="mt-1 leading-6">{location.address}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-lacquer">
                    {t.locations.phone}
                  </dt>
                  <dd class="mt-1 leading-6">{location.phone}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-lacquer">
                    {t.locations.hours}
                  </dt>
                  <dd class="mt-1 leading-6">{location.hours}</dd>
                </div>
              </dl>
              <LocationActions
                location={location}
                callLabel={t.cta.call}
                mapLabel={t.cta.map}
                spacingClass="mt-6"
              />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>
