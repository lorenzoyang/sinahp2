---
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import LocationActions from "../LocationActions.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { brand, locations, type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import {
  cardClasses as sharedCardClasses,
  headingClasses,
  imageSizes,
  mediaClasses as sharedMediaClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const sectionClasses = {
  hero: sharedSectionClasses.heroDark,
  listing: sharedSectionClasses.inkBandTight,
};
const cardClasses = {
  location: `overflow-hidden ${sharedCardClasses.paperPanel}`,
  carousel: "relative overflow-hidden bg-ink",
  track:
    "location-carousel-track scrollbar-hidden focus-ring flex snap-x snap-mandatory overflow-x-auto scroll-smooth",
  slide: "relative aspect-16/10 w-full shrink-0 snap-center overflow-hidden",
  image: sharedMediaClasses.absoluteImage,
  dots:
    "absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 gap-2 rounded-full bg-ink/72 px-2.5 py-2 shadow-lg shadow-black/20 backdrop-blur",
  dot: "focus-ring block h-2.5 w-2.5 cursor-pointer appearance-none rounded-full border-0 bg-paper/72 p-0 ring-1 ring-white/20 transition hover:bg-gold focus-visible:bg-gold",
  label: "text-xs font-semibold uppercase tracking-[0.22em] text-lacquer",
};

const restaurantInteriorLabels = {
  it: "interno del ristorante",
  zh: "门店室内环境",
  en: "restaurant interior",
  es: "interior del restaurante",
  fr: "intérieur du restaurant",
} as const satisfies Record<Locale, string>;

function formatA11yLabel(
  template: string,
  values: Record<string, string | number>,
) {
  return Object.entries(values).reduce(
    (label, [key, value]) => label.replaceAll(`{${key}}`, String(value)),
    template,
  );
}

const locationCards = locations.map((location) => ({
  ...location,
  slides: location.gallery.map((photo, index) => {
    const number = index + 1;
    const photoLabel = formatA11yLabel(t.a11y.photoLabel, {
      city: location.city,
      number,
    });

    return {
      id: `location-${location.id}-photo-${number}`,
      photo,
      alt: `${brand.publicName} ${location.city} ${restaurantInteriorLabels[locale]} ${number}`,
      label: photoLabel,
    };
  }),
}));
---

<SiteLayout
  locale={locale}
  page="locations"
  title={`${t.locations.title} | Sina Hotpot`}
  description={t.locations.intro}
>
  <section class={sectionClasses.hero}>
    <SectionHeader
      eyebrow={t.locations.eyebrow}
      title={t.locations.title}
      intro={t.locations.intro}
      containerClass="mx-auto max-w-7xl"
      titleClass={headingClasses.heroTitle}
      introClass={headingClasses.heroIntro}
    />
  </section>

  <section class={sectionClasses.listing}>
    <div class="mx-auto grid max-w-7xl gap-5 lg:grid-cols-2">
      {
        locationCards.map((location) => (
          <article class={cardClasses.location}>
            <div
              class={cardClasses.carousel}
              role="region"
              aria-label={formatA11yLabel(t.a11y.restaurantPhotos, {
                city: location.city,
              })}
              aria-roledescription={t.a11y.carousel}
              data-location-carousel
            >
              <div
                class={cardClasses.track}
                tabindex="0"
                aria-label={formatA11yLabel(t.a11y.photoSlides, {
                  city: location.city,
                })}
                data-location-carousel-track
              >
                {
                  location.slides.map((slide) => (
                    <div id={slide.id} class={cardClasses.slide}>
                      <Image
                        src={slide.photo}
                        alt={slide.alt}
                        class={cardClasses.image}
                        width={imageSizes.splitPanel.width}
                        widths={imageSizes.splitPanel.widths}
                        sizes={imageSizes.splitPanel.sizes}
                        loading="lazy"
                      />
                    </div>
                  ))
                }
              </div>
              {
                location.slides.length > 1 && (
                  <nav
                    class={cardClasses.dots}
                    aria-label={formatA11yLabel(t.a11y.photoNavigation, {
                      city: location.city,
                    })}
                  >
                    {
                      location.slides.map((slide) => (
                        <button
                          type="button"
                          class={cardClasses.dot}
                          aria-label={slide.label}
                          aria-controls={slide.id}
                          aria-current={slide.id.endsWith("-1")
                            ? "true"
                            : undefined}
                          data-location-carousel-dot
                          data-slide-id={slide.id}
                        />
                      ))
                    }
                  </nav>
                )
              }
            </div>
            <div class="p-5 sm:p-6">
              <p class={cardClasses.label}>
                {t.locations.daily}
              </p>
              <h2 class="mt-3 text-3xl font-semibold">{location.city}</h2>
              <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-3">
                <div>
                  <dt class="font-semibold text-lacquer">
                    {t.locations.address}
                  </dt>
                  <dd class="mt-1 leading-6">{location.address}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-lacquer">
                    {t.locations.phone}
                  </dt>
                  <dd class="mt-1 leading-6">{location.phone}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-lacquer">
                    {t.locations.hours}
                  </dt>
                  <dd class="mt-1 leading-6">{location.hours}</dd>
                </div>
              </dl>
              <LocationActions
                location={location}
                callLabel={t.cta.call}
                mapLabel={t.cta.map}
                spacingClass="mt-6"
              />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>

<script>
  import "../../scripts/locationCarousel";
</script>
