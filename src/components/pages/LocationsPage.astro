---
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import LocationActions from "../LocationActions.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { brand, locations, type Locale } from "../../data/site";
import { copy } from "../../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const sectionClasses = {
  hero: "bg-ink px-4 py-12 sm:px-6 lg:px-8",
  listing: "page-band bg-ink-band px-4 py-12 sm:px-6 lg:px-8",
};
const headingClasses = {
  title: "mt-4 max-w-4xl text-4xl font-semibold leading-tight text-white sm:text-5xl",
  intro: "mt-5 max-w-3xl text-lg leading-8 text-paper-soft/82",
};
const cardClasses = {
  location: "overflow-hidden rounded-lg border border-white/12 bg-paper text-ink",
  carousel: "relative overflow-hidden bg-ink",
  track:
    "location-carousel-track scrollbar-hidden focus-ring flex snap-x snap-mandatory overflow-x-auto scroll-smooth",
  slide: "relative aspect-16/10 w-full shrink-0 snap-center overflow-hidden",
  image: "absolute inset-0 h-full w-full object-cover",
  dots:
    "absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 gap-2 rounded-full bg-ink/72 px-2.5 py-2 shadow-lg shadow-black/20 backdrop-blur",
  dot: "focus-ring block h-2.5 w-2.5 cursor-pointer appearance-none rounded-full border-0 bg-paper/72 p-0 ring-1 ring-white/20 transition hover:bg-gold focus-visible:bg-gold",
  label: "text-xs font-semibold uppercase tracking-[0.22em] text-lacquer",
};

const locationCards = locations.map((location) => ({
  ...location,
  slides: location.gallery.map((photo, index) => {
    const number = index + 1;

    return {
      id: `location-${location.id}-photo-${number}`,
      photo,
      alt: `${brand.publicName} ${location.city} restaurant photo ${number}`,
      label: `${location.city} photo ${number}`,
    };
  }),
}));
---

<SiteLayout
  locale={locale}
  page="locations"
  title={`${t.locations.title} | Sina Hotpot`}
  description={t.locations.intro}
>
  <section class={sectionClasses.hero}>
    <SectionHeader
      eyebrow={t.locations.eyebrow}
      title={t.locations.title}
      intro={t.locations.intro}
      containerClass="mx-auto max-w-7xl"
      titleClass={headingClasses.title}
      introClass={headingClasses.intro}
    />
  </section>

  <section class={sectionClasses.listing}>
    <div class="mx-auto grid max-w-7xl gap-5 lg:grid-cols-2">
      {
        locationCards.map((location) => (
          <article class={cardClasses.location}>
            <div
              class={cardClasses.carousel}
              role="region"
              aria-label={`${location.city} restaurant photos`}
              aria-roledescription="carousel"
            >
              <div
                class={cardClasses.track}
                tabindex="0"
                aria-label={`${location.city} photo slides`}
              >
                {
                  location.slides.map((slide) => (
                    <div id={slide.id} class={cardClasses.slide}>
                      <Image
                        src={slide.photo}
                        alt={slide.alt}
                        class={cardClasses.image}
                        width={1200}
                        widths={[360, 640, 900, 1200]}
                        sizes="(min-width: 1024px) 50vw, 100vw"
                        loading="lazy"
                      />
                    </div>
                  ))
                }
              </div>
              {
                location.slides.length > 1 && (
                  <nav
                    class={cardClasses.dots}
                    aria-label={`${location.city} photo navigation`}
                  >
                    {
                      location.slides.map((slide) => (
                        <button
                          type="button"
                          class={cardClasses.dot}
                          aria-label={slide.label}
                          aria-controls={slide.id}
                          data-location-carousel-dot
                          data-slide-id={slide.id}
                        />
                      ))
                    }
                  </nav>
                )
              }
            </div>
            <div class="p-5 sm:p-6">
              <p class={cardClasses.label}>
                {t.locations.daily}
              </p>
              <h2 class="mt-3 text-3xl font-semibold">{location.city}</h2>
              <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-3">
                <div>
                  <dt class="font-semibold text-lacquer">
                    {t.locations.address}
                  </dt>
                  <dd class="mt-1 leading-6">{location.address}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-lacquer">
                    {t.locations.phone}
                  </dt>
                  <dd class="mt-1 leading-6">{location.phone}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-lacquer">
                    {t.locations.hours}
                  </dt>
                  <dd class="mt-1 leading-6">{location.hours}</dd>
                </div>
              </dl>
              <LocationActions
                location={location}
                callLabel={t.cta.call}
                mapLabel={t.cta.map}
                spacingClass="mt-6"
              />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>

<script>
  import "../../scripts/locationCarousel";
</script>
