---
import { getImage, Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import CtaLink from "../ui/CtaLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import {
  brand,
  getPath,
  type Locale,
} from "../../data/site";
import { copy } from "../../data/copy";
import {
  galleryHeroPhoto,
  galleryVideo,
  getGalleryPhotoCountLabel,
  getGalleryPhotoTotal,
  getVisibleGalleryGroups,
} from "../../data/gallery";
import { getPageSeoMeta, getVideoStructuredData } from "../../data/seo";
import {
  headingClasses,
  imageSizes,
  layoutClasses as sharedLayoutClasses,
  mediaClasses as sharedMediaClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const seoMeta = getPageSeoMeta(locale, "gallery");

const visibleGroups = getVisibleGalleryGroups().map((group) => ({
  ...group,
  label: t.gallery.categories[group.id],
  photoCountLabel: getGalleryPhotoCountLabel(group.photos.length, locale),
}));

const heroPhoto = galleryHeroPhoto;
const galleryTotal = getGalleryPhotoTotal(visibleGroups);
const galleryTotalLabel = getGalleryPhotoCountLabel(galleryTotal, locale);
const videoCopy = t.gallery.video;
const videoPoster = await getImage({
  src: galleryVideo.poster,
  width: galleryVideo.width,
  height: galleryVideo.height,
  format: "webp",
});
const videoStructuredData = getVideoStructuredData({
  locale,
  name: videoCopy.title,
  description: videoCopy.intro,
  contentUrl: galleryVideo.src,
  thumbnailUrl: videoPoster.src,
  uploadDate: galleryVideo.uploadDate,
  durationSeconds: galleryVideo.durationSeconds,
  pagePath: getPath(locale, "gallery"),
});
const sectionClasses = {
  hero: sharedSectionClasses.heroDark,
  bandDark: sharedSectionClasses.darkTight,
  bandInk: sharedSectionClasses.inkBandTight,
};
const layoutClasses = {
  heroContent: "grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-end",
  heroActions: "mt-7 flex flex-col gap-3 sm:flex-row",
  groupNav: "mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4",
  sectionContent: sharedLayoutClasses.container,
  sectionHeader:
    "flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between",
  photoGrid: "mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4",
  videoContent:
    `${sharedLayoutClasses.container} grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-center`,
  videoActions: "mt-7 flex flex-col gap-3 sm:flex-row",
  videoControls:
    "absolute inset-x-0 bottom-0 flex items-center justify-between gap-3 p-4",
};
const mediaClasses = {
  heroFrame:
    "relative aspect-4/3 min-w-0 overflow-hidden rounded-lg border border-white/12 bg-ink-panel shadow-2xl shadow-black/20 sm:aspect-16/9 lg:aspect-21/9",
  card:
    "group focus-ring relative min-h-36 overflow-hidden rounded-lg border border-white/12 bg-ink-panel transition hover:border-gold",
  tile: sharedMediaClasses.darkTile,
  image: sharedMediaClasses.hoverImage,
  heroImage: sharedMediaClasses.absoluteImage,
  heroOverlay:
    "absolute inset-0 bg-linear-to-t from-ink/64 via-transparent to-transparent",
  cardOverlay:
    "absolute inset-0 bg-linear-to-t from-ink/82 via-ink/18 to-transparent",
  videoFrame:
    "relative mx-auto aspect-9/16 w-full min-w-0 max-w-[320px] overflow-hidden rounded-lg border border-white/12 bg-ink-panel shadow-2xl shadow-black/20",
  video: "absolute inset-0 h-full w-full object-cover",
  videoOverlay:
    "pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-linear-to-t from-ink/78 to-transparent",
};
const buttonClasses = {
  videoControl:
    "focus-ring inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/16 bg-black/45 text-paper-soft backdrop-blur transition hover:border-gold hover:text-gold",
};
const textClasses = {
  totalBadge:
    "absolute bottom-4 left-4 rounded-md border border-white/12 bg-black/28 px-3 py-2 text-sm font-semibold text-paper-soft backdrop-blur",
  cardCaption: "absolute inset-x-0 bottom-0 p-4",
  cardTitle: "text-lg font-semibold leading-tight text-white",
  cardCount: "mt-1 text-sm font-medium text-paper-soft/74",
  groupCount: "text-sm font-semibold text-paper-soft/62",
};
---

<SiteLayout
  locale={locale}
  page="gallery"
  title={seoMeta?.title}
  description={seoMeta?.description}
  socialImage={heroPhoto.src}
  extraStructuredData={[videoStructuredData]}
>
  <section class={sectionClasses.hero}>
    <div class={sharedLayoutClasses.container}>
      <div class={layoutClasses.heroContent}>
        <SectionHeader
          eyebrow={t.gallery.eyebrow}
          title={t.gallery.title}
          intro={t.gallery.intro}
          containerClass="py-4"
        >
          <div class={layoutClasses.heroActions}>
            <CtaLink href={getPath(locale, "reservation")} variant="gold">
              {t.cta.reserve}
            </CtaLink>
            <CtaLink href={getPath(locale, "locations")} variant="whiteOutline">
              {t.nav.locations}
            </CtaLink>
          </div>
        </SectionHeader>

        {
          heroPhoto && (
            <figure class={mediaClasses.heroFrame}>
              <Image
                src={heroPhoto}
                alt={`${brand.publicName} ${t.gallery.title}`}
                class={mediaClasses.heroImage}
                width={imageSizes.heroWide.width}
                widths={imageSizes.heroWide.widths}
                sizes={imageSizes.heroWide.sizes}
                loading="eager"
              />
              <div class={mediaClasses.heroOverlay}></div>
              <p class={textClasses.totalBadge}>
                {galleryTotalLabel}
              </p>
            </figure>
          )
        }
      </div>

      {
        visibleGroups.length > 0 && (
          <nav
            class={layoutClasses.groupNav}
            aria-label={t.gallery.title}
          >
            {visibleGroups.map((group) => (
              <a class={mediaClasses.card} href={`#${group.sectionId}`}>
                <Image
                  src={group.coverPhoto}
                  alt={`${brand.publicName} ${group.label}`}
                  class={mediaClasses.image}
                  width={imageSizes.card.width}
                  widths={imageSizes.card.widths}
                  sizes={imageSizes.card.sizes}
                  loading="lazy"
                />
                <div class={mediaClasses.cardOverlay} />
                <div class={textClasses.cardCaption}>
                  <p class={textClasses.cardTitle}>
                    {group.label}
                  </p>
                  <p class={textClasses.cardCount}>
                    {group.photoCountLabel}
                  </p>
                </div>
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </section>

  <section class={sectionClasses.bandInk}>
    <div class={layoutClasses.videoContent}>
      <SectionHeader
        eyebrow={videoCopy.eyebrow}
        title={videoCopy.title}
        intro={videoCopy.intro}
        headingTag="h2"
        containerClass="max-w-3xl"
        eyebrowClass={headingClasses.darkEyebrow}
        titleClass={headingClasses.darkTitle}
        introClass={headingClasses.darkIntro}
      >
        <div class={layoutClasses.videoActions}>
          <CtaLink href={getPath(locale, "reservation")} variant="gold">
            {t.cta.reserve}
          </CtaLink>
        </div>
      </SectionHeader>

      <figure
        class={mediaClasses.videoFrame}
        data-gallery-video
        data-playing="false"
        data-muted="true"
        data-play-label={videoCopy.play}
        data-pause-label={videoCopy.pause}
        data-mute-label={videoCopy.mute}
        data-unmute-label={videoCopy.unmute}
      >
        <video
          class={mediaClasses.video}
          data-gallery-video-player
          src={galleryVideo.src}
          poster={videoPoster.src}
          width={galleryVideo.width}
          height={galleryVideo.height}
          aria-label={`${brand.publicName} ${videoCopy.title}`}
          preload="metadata"
          playsinline
          muted
          loop></video>
        <div class={mediaClasses.videoOverlay}></div>

        <div class={layoutClasses.videoControls}>
          <button
            type="button"
            class={buttonClasses.videoControl}
            data-gallery-video-toggle
            aria-label={videoCopy.play}
            title={videoCopy.play}
          >
            <svg
              data-video-icon="play"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M8.2 5.1 19 12 8.2 18.9z"></path>
            </svg>
            <svg
              data-video-icon="pause"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M6.6 5h3.5v14H6.6zM13.9 5h3.5v14h-3.5z"></path>
            </svg>
          </button>

          <button
            type="button"
            class={buttonClasses.videoControl}
            data-gallery-video-sound
            aria-pressed="false"
            aria-label={videoCopy.unmute}
            title={videoCopy.unmute}
          >
            <svg
              data-video-icon="sound-off"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M11 4.6 6.7 8.3H3.4v7.4h3.3L11 19.4z"
                fill="currentColor"></path>
              <path
                d="m15.4 9.4 4.4 5.2M19.8 9.4l-4.4 5.2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"></path>
            </svg>
            <svg
              data-video-icon="sound-on"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M11 4.6 6.7 8.3H3.4v7.4h3.3L11 19.4z"
                fill="currentColor"></path>
              <path
                d="M14.8 9.1c1.2 1.7 1.2 4.1 0 5.8M17.5 7.2c2.2 2.9 2.2 6.7 0 9.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </figure>
    </div>
  </section>

  {
    visibleGroups.map((group, groupIndex) => (
      <section
        id={group.sectionId}
        class={groupIndex % 2 === 0
          ? sectionClasses.bandDark
          : sectionClasses.bandInk}
      >
        <div class={layoutClasses.sectionContent}>
          <div class={layoutClasses.sectionHeader}>
            <SectionHeader
              eyebrow={brand.publicName}
              title={group.label}
              headingTag="h2"
              containerClass="max-w-3xl"
              eyebrowClass={headingClasses.darkEyebrow}
              titleClass={headingClasses.darkTitle}
              introClass={headingClasses.darkIntro}
            />
            <p class={textClasses.groupCount}>
              {group.photoCountLabel}
            </p>
          </div>

          <div class={layoutClasses.photoGrid}>
            {group.photos.map((photo, index) => (
              <figure class={mediaClasses.tile}>
                <Image
                  src={photo}
                  alt={`${brand.publicName} ${group.label} ${index + 1}`}
                  class={mediaClasses.image}
                  width={imageSizes.tile.width}
                  widths={imageSizes.tile.widths}
                  sizes={imageSizes.tile.sizes}
                  loading={groupIndex === 0 && index < 2 ? "eager" : "lazy"}
                />
              </figure>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <script>
    import "../../scripts/galleryVideo";
  </script>
</SiteLayout>
