---
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import CtaLink from "../ui/CtaLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import {
  brand,
  getPath,
  type Locale,
} from "../../data/site";
import { copy } from "../../data/copy";
import { galleryFallbackImages, galleryGroups } from "../../data/gallery";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];

const photoCountLabel = (count: number) => `${count} foto`;
const visibleGroups = galleryGroups.flatMap((group) => {
  const [coverPhoto] = group.photos;

  if (!coverPhoto) {
    return [];
  }

  return {
    ...group,
    coverPhoto,
    sectionId: `gallery-${group.id}`,
    label: t.gallery.categories[group.id],
    photoCountLabel: photoCountLabel(group.photos.length),
  };
});

const heroPhoto =
  visibleGroups.find((group) => group.id === "table")?.coverPhoto ??
  galleryFallbackImages.table;
const galleryTotal = visibleGroups.reduce(
  (total, group) => total + group.photos.length,
  0,
);
const galleryTotalLabel = photoCountLabel(galleryTotal);
const sectionClasses = {
  hero: "bg-ink px-4 py-12 sm:px-6 lg:px-8",
  band: "page-band px-4 py-12 sm:px-6 lg:px-8",
};
const headingClasses = {
  darkEyebrow: "text-xs font-semibold uppercase tracking-[0.24em] text-gold",
  darkTitle: "mt-3 text-3xl font-semibold leading-tight text-white sm:text-4xl",
  darkIntro: "mt-4 max-w-3xl text-base leading-7 text-paper-soft/76",
};
const mediaClasses = {
  heroFrame:
    "relative aspect-4/3 min-w-0 overflow-hidden rounded-lg border border-white/12 bg-ink-panel shadow-2xl shadow-black/20 sm:aspect-16/9 lg:aspect-21/9",
  card:
    "group focus-ring relative min-h-36 overflow-hidden rounded-lg border border-white/12 bg-ink-panel transition hover:border-gold",
  tile:
    "group relative aspect-4/3 min-w-0 overflow-hidden rounded-lg border border-white/12 bg-ink-panel",
  image:
    "absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]",
};
const imageSizes = {
  hero: {
    width: 1400,
    widths: [420, 720, 960, 1200, 1600],
    sizes: "(min-width: 1024px) 58vw, 92vw",
  },
  card: {
    width: 720,
    widths: [320, 520, 720, 960],
    sizes: "(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 92vw",
  },
  tile: {
    width: 900,
    widths: [320, 520, 720, 960, 1200],
    sizes:
      "(min-width: 1280px) 23vw, (min-width: 1024px) 31vw, (min-width: 640px) 45vw, 92vw",
  },
};
---

<SiteLayout
  locale={locale}
  page="gallery"
  title={`${t.gallery.title} | Sina Hotpot`}
  description={t.gallery.intro}
>
  <section class={sectionClasses.hero}>
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
        <SectionHeader
          eyebrow={t.gallery.eyebrow}
          title={t.gallery.title}
          intro={t.gallery.intro}
          containerClass="py-4"
        >
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <CtaLink href={getPath(locale, "reservation")} variant="gold">
              {t.cta.reserve}
            </CtaLink>
            <CtaLink href={getPath(locale, "locations")} variant="whiteOutline">
              {t.nav.locations}
            </CtaLink>
          </div>
        </SectionHeader>

        <figure class={mediaClasses.heroFrame}>
          <Image
            src={heroPhoto}
            alt={`${brand.publicName} ${t.gallery.title}`}
            class="absolute inset-0 h-full w-full object-cover"
            width={imageSizes.hero.width}
            widths={imageSizes.hero.widths}
            sizes={imageSizes.hero.sizes}
            loading="eager"
          />
          <div
            class="absolute inset-0 bg-linear-to-t from-ink/64 via-transparent to-transparent"
          >
          </div>
          <p
            class="absolute bottom-4 left-4 rounded-md border border-white/12 bg-black/28 px-3 py-2 text-sm font-semibold text-paper-soft backdrop-blur"
          >
            {galleryTotalLabel}
          </p>
        </figure>
      </div>

      {
        visibleGroups.length > 0 && (
          <nav
            class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"
            aria-label={t.gallery.title}
          >
            {visibleGroups.map((group) => (
              <a class={mediaClasses.card} href={`#${group.sectionId}`}>
                <Image
                  src={group.coverPhoto}
                  alt={`${brand.publicName} ${group.label}`}
                  class={mediaClasses.image}
                  width={imageSizes.card.width}
                  widths={imageSizes.card.widths}
                  sizes={imageSizes.card.sizes}
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-linear-to-t from-ink/82 via-ink/18 to-transparent" />
                <div class="absolute inset-x-0 bottom-0 p-4">
                  <p class="text-lg font-semibold leading-tight text-white">
                    {group.label}
                  </p>
                  <p class="mt-1 text-sm font-medium text-paper-soft/74">
                    {group.photoCountLabel}
                  </p>
                </div>
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </section>

  {
    visibleGroups.map((group, groupIndex) => (
      <section
        id={group.sectionId}
        class:list={[
          sectionClasses.band,
          groupIndex % 2 === 0 ? "bg-ink-band" : "bg-ink",
        ]}
      >
        <div class="mx-auto max-w-7xl">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <SectionHeader
              eyebrow={brand.publicName}
              title={group.label}
              headingTag="h2"
              containerClass="max-w-3xl"
              eyebrowClass={headingClasses.darkEyebrow}
              titleClass={headingClasses.darkTitle}
              introClass={headingClasses.darkIntro}
            />
            <p class="text-sm font-semibold text-paper-soft/62">
              {group.photoCountLabel}
            </p>
          </div>

          <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {group.photos.map((photo, index) => (
              <figure class={mediaClasses.tile}>
                <Image
                  src={photo}
                  alt={`${brand.publicName} ${group.label} photo ${index + 1}`}
                  class={mediaClasses.image}
                  width={imageSizes.tile.width}
                  widths={imageSizes.tile.widths}
                  sizes={imageSizes.tile.sizes}
                  loading={groupIndex === 0 && index < 2 ? "eager" : "lazy"}
                />
              </figure>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</SiteLayout>
