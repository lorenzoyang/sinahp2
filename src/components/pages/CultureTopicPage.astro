---
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import CtaLink from "../ui/CtaLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import {
  getCultureTopicAlternatePaths,
  getCultureTopicPath,
  getPath,
  type CultureTopicId,
  type Locale,
} from "../../data/site";
import { copy } from "../../data/copy";
import {
  getCultureTopic,
  getCultureTopicContent,
  getRelatedCultureTopics,
} from "../../data/cultureTopics";
import { formatSequenceNumber } from "../../utils/presentation";
import {
  cardClasses as sharedCardClasses,
  headingClasses,
  imageSizes,
  layoutClasses as sharedLayoutClasses,
  mediaClasses as sharedMediaClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
  topicId: CultureTopicId;
}

const { locale, topicId } = Astro.props;
const t = copy[locale];
const topic = getCultureTopic(topicId);
const content = getCultureTopicContent(locale, topicId);
const relatedTopics = getRelatedCultureTopics(locale, topicId);
const alternatePaths = getCultureTopicAlternatePaths(topicId);
const sectionClasses = {
  topicHero: "relative overflow-hidden bg-ink",
  dark: sharedSectionClasses.dark,
  inkBand: sharedSectionClasses.inkBand,
  paper: sharedSectionClasses.paper,
};
const layoutClasses = {
  heroContent: `${sharedLayoutClasses.containerNarrow} relative px-4 py-14 sm:px-6 lg:px-8`,
  highlights: "mt-8 grid gap-3 sm:grid-cols-3",
  contentGrid: `${sharedLayoutClasses.containerNarrow} grid gap-5`,
  tipsGrid: `${sharedLayoutClasses.containerNarrow} grid gap-8 lg:grid-cols-[0.8fr_1.2fr]`,
  tipsList: "grid gap-3",
  actions: "flex flex-col gap-3 sm:flex-row",
  relatedGrid: "mt-10 grid gap-4 md:grid-cols-3",
};
const mediaClasses = {
  heroBackdrop: "absolute inset-0",
  heroImage: `${sharedMediaClasses.absoluteImage} opacity-40`,
  heroVerticalOverlay:
    "absolute inset-0 bg-linear-to-b from-ink/50 via-ink/82 to-ink",
  heroHorizontalOverlay:
    "absolute inset-0 bg-linear-to-r from-ink/92 via-ink/62 to-transparent",
};
const topicHeadingClasses = {
  heroEyebrow:
    "mt-8 max-w-full break-words text-xs font-semibold uppercase leading-5 tracking-normal text-gold",
  heroIntro: "mt-5 max-w-3xl text-lg leading-8 text-paper-soft/86",
};
const cardClasses = {
  highlight:
    "rounded-md border border-white/12 bg-black/18 px-4 py-3 text-sm font-semibold text-paper-soft backdrop-blur",
  content: `${sharedCardClasses.lightSoft} p-5 sm:p-6`,
  tip: `${sharedCardClasses.dark} px-5 py-4 text-base leading-7 text-paper-soft/82`,
  related: `focus-ring ${sharedCardClasses.darkInteractive} p-5`,
};
const textClasses = {
  backLink:
    "focus-ring inline-flex rounded-md text-sm font-semibold text-gold hover:text-white",
  contentSequence: "text-sm font-semibold text-lacquer",
  contentTitle: "mt-3 text-2xl font-semibold leading-tight",
  contentBody: "mt-4 text-base leading-8 text-brown-body",
  relatedKicker:
    "max-w-full wrap-break-word text-xs font-semibold uppercase leading-5 tracking-normal text-gold",
  relatedTitle: "mt-3 text-xl font-semibold leading-tight text-white",
  relatedSummary: "mt-3 text-sm leading-6 text-paper-soft/72",
};
---

<SiteLayout
  locale={locale}
  page="culture"
  title={`${content.title} | Sina Hotpot`}
  description={content.summary}
  alternatePaths={alternatePaths}
  socialImage={topic.image.src}
>
  <section class={sectionClasses.topicHero}>
    <div class={mediaClasses.heroBackdrop}>
      <Image
        src={topic.image}
        alt=""
        class={mediaClasses.heroImage}
        width={imageSizes.fullBleedHero.width}
        widths={imageSizes.fullBleedHero.widths}
        sizes={imageSizes.fullBleedHero.sizes}
        loading="eager"
      />
      <div class={mediaClasses.heroVerticalOverlay}></div>
      <div class={mediaClasses.heroHorizontalOverlay}></div>
    </div>
    <div class={layoutClasses.heroContent}>
      <a
        class={textClasses.backLink}
        href={getPath(locale, "culture")}
      >
        {t.nav.culture}
      </a>
      <SectionHeader
        eyebrow={content.kicker}
        title={content.title}
        intro={content.detailIntro}
        eyebrowClass={topicHeadingClasses.heroEyebrow}
        introClass={topicHeadingClasses.heroIntro}
      />
      <div class={layoutClasses.highlights}>
        {
          content.highlights.map((item) => (
            <p class={cardClasses.highlight}>{item}</p>
          ))
        }
      </div>
    </div>
  </section>

  <section class={sectionClasses.paper}>
    <div class={layoutClasses.contentGrid}>
      {
        content.sections.map((section, index) => (
          <article class={cardClasses.content}>
            <p class={textClasses.contentSequence}>
              {formatSequenceNumber(index)}
            </p>
            <h2 class={textClasses.contentTitle}>
              {section.title}
            </h2>
            <p class={textClasses.contentBody}>
              {section.body}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class={sectionClasses.inkBand}>
    <div class={layoutClasses.tipsGrid}>
      <SectionHeader
        eyebrow="Sina Hotpot"
        title={content.tipsTitle}
        headingTag="h2"
        eyebrowClass={headingClasses.darkEyebrow}
        titleClass={headingClasses.darkTitle}
      />
      <div class={layoutClasses.tipsList}>
        {content.tips.map((tip) => <p class={cardClasses.tip}>{tip}</p>)}
      </div>
    </div>
  </section>

  <section class={sectionClasses.dark}>
    <div class={sharedLayoutClasses.containerNarrow}>
      <div class={layoutClasses.actions}>
        <CtaLink href={getPath(locale, "reservation")} variant="gold">
          {t.cta.reserve}
        </CtaLink>
        <CtaLink href={getPath(locale, "culture")} variant="whiteOutline">
          {t.nav.culture}
        </CtaLink>
      </div>

      <div class={layoutClasses.relatedGrid}>
        {
          relatedTopics.map((related) => (
            <a
              class={cardClasses.related}
              href={getCultureTopicPath(locale, related.id)}
            >
              <p class={textClasses.relatedKicker}>
                {related.kicker}
              </p>
              <h3 class={textClasses.relatedTitle}>
                {related.title}
              </h3>
              <p class={textClasses.relatedSummary}>
                {related.summary}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
