---
import { Image } from "astro:assets";
import ReservationForm from "../ReservationForm.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import { reservationImages } from "../../data/pageImages";
import { getPageSeoMeta } from "../../data/seo";
import {
  imageSizes,
  layoutClasses as sharedLayoutClasses,
  mediaClasses as sharedMediaClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const seoMeta = getPageSeoMeta(locale, "reservation");
const sectionClasses = {
  hero: sharedSectionClasses.heroDark,
};
const layoutClasses = {
  content: `${sharedLayoutClasses.container} grid min-w-0 gap-8 lg:grid-cols-[0.85fr_1fr] lg:items-start`,
  intro: "min-w-0 lg:col-start-1 lg:row-start-1",
  form: "min-w-0 lg:col-start-2 lg:row-span-2 lg:row-start-1",
  media: "min-w-0 lg:col-start-1 lg:row-start-2",
};
const mediaClasses = {
  frame: `${sharedMediaClasses.landscapeFrame} mt-7`,
  image: sharedMediaClasses.absoluteImage,
};
---

<SiteLayout
  locale={locale}
  page="reservation"
  title={seoMeta?.title}
  description={seoMeta?.description}
  socialImage={reservationImages.hero.src}
>
  <section class={sectionClasses.hero}>
    <div class={layoutClasses.content}>
      <div class={layoutClasses.intro}>
        <SectionHeader
          eyebrow={t.reservation.eyebrow}
          title={t.reservation.title}
        />
      </div>
      <div class={layoutClasses.form}>
        <ReservationForm locale={locale} />
      </div>
      <div class={layoutClasses.media}>
        <div class={mediaClasses.frame}>
          <Image
            src={reservationImages.hero}
            alt=""
            class={mediaClasses.image}
            width={imageSizes.splitPanel.width}
            widths={imageSizes.splitPanel.widths}
            sizes={imageSizes.splitPanel.sizes}
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </section>
</SiteLayout>
