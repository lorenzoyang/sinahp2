---
import { Image } from "astro:assets";
import ReservationForm from "../ReservationForm.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { brand, type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import { reservationImages } from "../../data/pageImages";
import { getPageSeoMeta } from "../../data/seo";
import {
  imageSizes,
  mediaClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const seoMeta = getPageSeoMeta(locale, "reservation");
const pageClasses = {
  section: sharedSectionClasses.heroDark,
  heroImageFrame: `${mediaClasses.landscapeFrame} mt-7`,
  heroImage: mediaClasses.absoluteImage,
};
---

<SiteLayout
  locale={locale}
  page="reservation"
  title={seoMeta?.title}
  description={seoMeta?.description}
  socialImage={reservationImages.hero.src}
>
  <section class={pageClasses.section}>
    <div
      class="mx-auto grid max-w-7xl min-w-0 gap-8 lg:grid-cols-[0.85fr_1fr] lg:items-start"
    >
      <div class="min-w-0 lg:col-start-1 lg:row-start-1">
        <SectionHeader
          eyebrow={t.reservation.eyebrow}
          title={t.reservation.title}
        />
      </div>
      <div class="min-w-0 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <ReservationForm locale={locale} />
      </div>
      <div class="min-w-0 lg:col-start-1 lg:row-start-2">
        <div class={pageClasses.heroImageFrame}>
          <Image
            src={reservationImages.hero}
            alt=""
            class={pageClasses.heroImage}
            width={imageSizes.splitPanel.width}
            widths={imageSizes.splitPanel.widths}
            sizes={imageSizes.splitPanel.sizes}
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </section>
</SiteLayout>
