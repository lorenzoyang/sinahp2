---
import { Image } from "astro:assets";
import ReservationForm from "../ReservationForm.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { brand, type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import { reservationImages } from "../../data/pageImages";
import {
  imageSizes,
  mediaClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const pageClasses = {
  section: sharedSectionClasses.heroDark,
  heroImageFrame: `${mediaClasses.landscapeFrame} mt-7`,
  heroImage: mediaClasses.absoluteImage,
  contactGrid: "mt-6 grid gap-3 text-sm text-paper-soft/78",
  contactLink:
    "focus-ring rounded-md border border-white/12 px-4 py-3 hover:bg-white/10",
};
---

<SiteLayout
  locale={locale}
  page="reservation"
  title={`${t.reservation.title} | Sina Hotpot`}
  description={t.reservation.intro}
>
  <section class={pageClasses.section}>
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.85fr_1fr] lg:items-start"
    >
      <div class="lg:sticky lg:top-24">
        <SectionHeader
          eyebrow={t.reservation.eyebrow}
          title={t.reservation.title}
          intro={t.reservation.intro}
        />
        <div class={pageClasses.heroImageFrame}>
          <Image
            src={reservationImages.hero}
            alt=""
            class={pageClasses.heroImage}
            width={imageSizes.splitPanel.width}
            widths={imageSizes.splitPanel.widths}
            sizes={imageSizes.splitPanel.sizes}
            loading="lazy"
          />
        </div>
        <div class={pageClasses.contactGrid}>
          <a
            class={pageClasses.contactLink}
            href={brand.whatsappHref}
          >
            {t.cta.whatsapp}: {brand.whatsapp}
          </a>
          <a
            class={pageClasses.contactLink}
            href={`mailto:${brand.email}`}
          >
            {brand.email}
          </a>
        </div>
      </div>
      <ReservationForm locale={locale} />
    </div>
  </section>
</SiteLayout>
