---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CtaLink from "../ui/CtaLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { brand, getPath, locations, type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import {
  cardClasses as sharedCardClasses,
  layoutClasses as sharedLayoutClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const sectionClasses = {
  hero: sharedSectionClasses.heroDarkSpacious,
  locations: sharedSectionClasses.paperTight,
};
const layoutClasses = {
  locations: `${sharedLayoutClasses.container} grid gap-4 md:grid-cols-2`,
  actions: "mt-8 flex flex-col gap-3 sm:flex-row",
};
const textClasses = {
  intro: "mt-5 text-lg leading-8 text-paper-soft/84",
  next: "mt-4 text-base leading-7 text-paper-soft/72",
};
const cardClasses = {
  location: `${sharedCardClasses.light} p-5`,
};
---

<SiteLayout
  locale={locale}
  page="success"
  title={`${t.success.title} | Sina Hotpot`}
  description={t.success.intro}
  noindex
>
  <section class={sectionClasses.hero}>
    <SectionHeader
      eyebrow={brand.publicName}
      title={t.success.title}
      intro={t.success.intro}
      containerClass="mx-auto max-w-3xl"
      introClass={textClasses.intro}
    >
      <p class={textClasses.next}>{t.success.next}</p>
      <div class={layoutClasses.actions}>
        <CtaLink href={getPath(locale, "locations")} variant="gold">
          {t.nav.locations}
        </CtaLink>
        <CtaLink href={brand.whatsappHref} variant="whiteOutlineStatic">
          {t.cta.whatsapp}
        </CtaLink>
      </div>
    </SectionHeader>
  </section>

  <section class={sectionClasses.locations}>
    <div class={layoutClasses.locations}>
      {
        locations.map((location) => (
          <article class={cardClasses.location}>
            <h2 class="text-2xl font-semibold">{location.city}</h2>
            <p class="mt-2 text-sm leading-6">{location.address}</p>
            <p class="mt-1 text-sm leading-6">{location.hours}</p>
            <CtaLink
              href={location.mapHref}
              variant="redSmall"
              class="mt-5"
              external
            >
              {t.cta.map}
            </CtaLink>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>
