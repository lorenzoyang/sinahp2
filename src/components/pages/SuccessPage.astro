---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { brand, getPath, locations, type Locale } from "../../data/site";
import { copy } from "../../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<SiteLayout
  locale={locale}
  page="success"
  title={`${t.success.title} | Sina Hotpot`}
  description={t.success.intro}
>
  <section class="bg-[#15110f] px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p
        class="text-xs font-semibold uppercase tracking-[0.28em] text-[#c7a062]"
      >
        {brand.publicName}
      </p>
      <h1
        class="mt-4 text-4xl font-semibold leading-tight text-white sm:text-5xl"
      >
        {t.success.title}
      </h1>
      <p class="mt-5 text-lg leading-8 text-[#efe3d5]/84">{t.success.intro}</p>
      <p class="mt-4 text-base leading-7 text-[#efe3d5]/72">{t.success.next}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          class="focus-ring inline-flex min-h-12 items-center justify-center rounded-md bg-[#c7a062] px-5 py-3 font-semibold text-[#15110f]"
          href={getPath(locale, "locations")}
        >
          {t.nav.locations}
        </a>
        <a
          class="focus-ring inline-flex min-h-12 items-center justify-center rounded-md border border-white/18 px-5 py-3 font-semibold text-white"
          href={brand.whatsappHref}
        >
          {t.cta.whatsapp}
        </a>
      </div>
    </div>
  </section>

  <section
    class="page-band bg-[#f7f0e7] px-4 py-12 text-[#15110f] sm:px-6 lg:px-8"
  >
    <div class="mx-auto grid max-w-7xl gap-4 md:grid-cols-2">
      {
        locations.map((location) => (
          <article class="rounded-lg border border-[#d8c8b5] bg-white/62 p-5">
            <h2 class="text-2xl font-semibold">{location.city}</h2>
            <p class="mt-2 text-sm leading-6">{location.address}</p>
            <p class="mt-1 text-sm leading-6">{location.hours}</p>
            <a
              class="focus-ring mt-5 inline-flex rounded-md bg-[#8f241d] px-4 py-2 text-sm font-semibold text-white"
              href={location.mapHref}
              target="_blank"
              rel="noreferrer"
            >
              {t.cta.map}
            </a>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>
