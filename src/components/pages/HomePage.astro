---
import SiteLayout from "../../layouts/SiteLayout.astro";
import LocationActions from "../LocationActions.astro";
import CtaLink from "../ui/CtaLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import {
  brand,
  getPath,
  images,
  locations,
  type Locale,
} from "../../data/site";
import { copy } from "../../data/copy";
import { getHomeSections } from "../../data/homeSections";
import {
  formatSequenceNumber,
  getStaggerStyle,
} from "../../utils/presentation";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const homeSections = getHomeSections(locale);
const reservationPath = getPath(locale, "reservation");
const culturePath = getPath(locale, "culture");
const darkSectionEyebrowClass =
  "text-xs font-semibold uppercase tracking-[0.24em] text-[#c7a062]";
const darkSectionTitleClass =
  "mt-3 text-3xl font-semibold leading-tight text-white sm:text-4xl";
const darkSectionIntroClass = "mt-4 text-base leading-7 text-[#efe3d5]/76";
const lightSectionEyebrowClass =
  "text-xs font-semibold uppercase tracking-[0.24em] text-[#8f241d]";
const lightSectionTitleClass =
  "mt-3 text-3xl font-semibold leading-tight sm:text-4xl";
const lightSectionIntroClass = "mt-4 text-base leading-7 text-[#3c3028]";
const darkCardClass = "homepage-card rounded-lg border border-white/12 bg-white/5.5";
const lightCardClass =
  "homepage-card rounded-lg border border-[#d8c8b5] bg-white/70";
const lightCardSoftClass =
  "homepage-card rounded-lg border border-[#d8c8b5] bg-white/72";
const darkStatPillClass =
  "rounded-md border border-white/12 bg-black/18 px-4 py-3 text-sm font-medium text-[#efe3d5]";
const heroProofClass =
  "rounded-md border border-white/12 bg-black/18 px-3 py-3 text-sm font-medium text-[#efe3d5] backdrop-blur";
---

<SiteLayout locale={locale} page="home">
  <section class="homepage-hero relative overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={images.hero}
        alt=""
        class="hero-image-drift h-full w-full object-cover"
        width="1792"
        height="1024"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-linear-to-b from-[#15110f]/46 via-[#15110f]/64 to-[#15110f]"
      >
      </div>
      <div
        class="absolute inset-0 bg-linear-to-r from-[#15110f]/92 via-[#15110f]/56 to-transparent"
      >
      </div>
    </div>

    <div
      class="relative mx-auto flex min-h-[82svh] max-w-7xl items-end px-4 pb-10 pt-20 sm:px-6 lg:px-8"
    >
      <div class="max-w-3xl" data-reveal>
        <SectionHeader
          eyebrow={t.home.eyebrow}
          title={t.home.title}
          intro={t.home.intro}
          containerClass="max-w-3xl"
          titleClass="mt-5 text-5xl font-semibold leading-[0.95] text-white sm:text-6xl lg:text-7xl"
          introClass="mt-5 max-w-2xl text-lg leading-8 text-[#f7f0e7]/88 sm:text-xl"
        >
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <CtaLink href={reservationPath} variant="goldHero">
              {t.cta.reserve}
            </CtaLink>
            <CtaLink href={culturePath} variant="whiteOutlineHero">
              {t.cta.culture}
            </CtaLink>
          </div>
          <div class="mt-8 grid gap-2 sm:grid-cols-3">
            {
              t.home.proof.map((item, index) => (
                <p
                  class={heroProofClass}
                  data-reveal
                  style={getStaggerStyle(index, 120, 90)}
                >
                  {item}
                </p>
              ))
            }
          </div>
        </SectionHeader>
      </div>
    </div>
  </section>

  <section class="page-band bg-[#15110f] px-4 py-14 sm:px-6 lg:px-8">
    <div
      class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center"
    >
      <div data-reveal>
        <SectionHeader
          eyebrow={brand.publicName}
          title={t.home.sections.ritualTitle}
          intro={t.home.sections.ritualIntro}
          headingTag="h2"
          eyebrowClass={darkSectionEyebrowClass}
          titleClass={darkSectionTitleClass}
          introClass="mt-4 text-base leading-7 text-[#efe3d5]/78"
        />
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          t.home.steps.map(([title, text], index) => (
            <article
              class:list={[darkCardClass, "p-5"]}
              data-reveal
              style={getStaggerStyle(index, 0, 90)}
            >
              <span class="text-sm font-semibold text-[#c7a062]">
                {formatSequenceNumber(index)}
              </span>
              <h3 class="mt-4 text-xl font-semibold text-white">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-[#efe3d5]/74">{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="page-band bg-[#f7f0e7] px-4 py-14 text-[#15110f] sm:px-6 lg:px-8"
  >
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-center"
    >
      <div class="overflow-hidden rounded-lg" data-reveal>
        <img
          src={images.mealSpread}
          alt=""
          class="homepage-photo aspect-4/5 h-full w-full object-cover"
          width="1800"
          height="2250"
          loading="lazy"
        />
      </div>
      <div data-reveal style="--reveal-delay:80ms">
        <SectionHeader
          eyebrow={brand.publicName}
          title={t.home.sections.premiumTitle}
          intro={homeSections.signatures.intro}
          headingTag="h2"
          eyebrowClass={lightSectionEyebrowClass}
          titleClass={lightSectionTitleClass}
          introClass={lightSectionIntroClass}
        />
        <div class="mt-6 grid gap-3">
          {
            homeSections.signatures.items.map(([title, text], index) => (
              <article
                class:list={[lightCardClass, "p-4"]}
                data-reveal
                style={getStaggerStyle(index, 140, 80)}
              >
                <span class="text-sm font-semibold text-[#8f241d]">
                  {formatSequenceNumber(index)}
                </span>
                <h3 class="mt-3 text-lg font-semibold">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-[#5f5145]">{text}</p>
              </article>
            ))
          }
        </div>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            t.home.premium.map((item, index) => (
              <p
                class="rounded-full border border-[#d8c8b5] bg-white/72 px-4 py-2 text-sm font-medium text-[#3c3028]"
                data-reveal
                style={getStaggerStyle(index, 340, 70)}
              >
                {item}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="page-band bg-[#211612] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div data-reveal>
        <SectionHeader
          eyebrow={homeSections.occasions.eyebrow}
          title={homeSections.occasions.title}
          intro={homeSections.occasions.intro}
          headingTag="h2"
          containerClass="max-w-3xl"
          eyebrowClass={darkSectionEyebrowClass}
          titleClass={darkSectionTitleClass}
          introClass={darkSectionIntroClass}
        />
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          homeSections.occasions.items.map(([title, text], index) => (
            <article
              class:list={[darkCardClass, "p-5"]}
              data-reveal
              style={getStaggerStyle(index, 0, 90)}
            >
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#c7a062]">
                {formatSequenceNumber(index)}
              </p>
              <h3 class="mt-3 text-2xl font-semibold text-white">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-[#efe3d5]/74">{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="page-band bg-[#efe3d5] px-4 py-14 text-[#15110f] sm:px-6 lg:px-8"
  >
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.84fr_1.16fr] lg:items-center"
    >
      <div class="overflow-hidden rounded-lg" data-reveal>
        <img
          src={images.steamingSetup}
          alt=""
          class="homepage-photo aspect-4/5 h-full w-full object-cover"
          width="1800"
          height="2250"
          loading="lazy"
        />
      </div>
      <div data-reveal style="--reveal-delay:80ms">
        <SectionHeader
          eyebrow={homeSections.visit.eyebrow}
          title={homeSections.visit.title}
          intro={homeSections.visit.intro}
          headingTag="h2"
          eyebrowClass={lightSectionEyebrowClass}
          titleClass={lightSectionTitleClass}
          introClass={lightSectionIntroClass}
        />
        <div class="mt-6 grid gap-3">
          {
            homeSections.visit.items.map((item, index) => (
              <p
                class:list={[lightCardSoftClass, "px-4 py-4 text-base leading-7 text-[#3c3028]"]}
                data-reveal
                style={getStaggerStyle(index, 140, 80)}
              >
                <span class="mr-3 font-semibold text-[#8f241d]">
                  {formatSequenceNumber(index)}
                </span>
                {item}
              </p>
            ))
          }
        </div>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <CtaLink href={culturePath} variant="lightOutlineSmall">
            {t.cta.culture}
          </CtaLink>
          <CtaLink href={reservationPath} variant="redSmall">
            {t.cta.reserve}
          </CtaLink>
        </div>
      </div>
    </div>
  </section>

  <section class="page-band bg-[#15110f] px-4 py-14 sm:px-6 lg:px-8">
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-center"
    >
      <div
        class="grid gap-4 sm:grid-cols-[1.1fr_0.9fr] lg:items-stretch"
        data-reveal
      >
        <div class="overflow-hidden rounded-lg">
          <img
            src={images.table}
            alt=""
            class="homepage-photo aspect-4/5 h-full w-full object-cover"
            width="1800"
            height="2250"
            loading="lazy"
          />
        </div>
        <div class="grid gap-4">
          <div class="overflow-hidden rounded-lg">
            <img
              src={images.culture}
              alt=""
              class="homepage-photo aspect-square h-full w-full object-cover"
              width="1800"
              height="1800"
              loading="lazy"
            />
          </div>
          <div class="overflow-hidden rounded-lg">
            <img
              src={images.ingredients}
              alt=""
              class="homepage-photo aspect-square h-full w-full object-cover"
              width="1800"
              height="1800"
              loading="lazy"
            />
          </div>
        </div>
      </div>
      <div data-reveal style="--reveal-delay:100ms">
        <SectionHeader
          eyebrow={homeSections.atmosphere.eyebrow}
          title={homeSections.atmosphere.title}
          intro={homeSections.atmosphere.intro}
          headingTag="h2"
          eyebrowClass={darkSectionEyebrowClass}
          titleClass={darkSectionTitleClass}
          introClass={darkSectionIntroClass}
        />
        <div class="mt-6 grid gap-3">
          {
            homeSections.atmosphere.items.map((item, index) => (
              <p
                class:list={[darkCardClass, "px-4 py-4 text-base leading-7 text-[#efe3d5]/82"]}
                data-reveal
                style={getStaggerStyle(index, 160, 80)}
              >
                {item}
              </p>
            ))
          }
        </div>
        <div class="mt-6 grid gap-2 sm:grid-cols-2">
          {
            homeSections.atmosphere.stats.map((item, index) => (
              <p
                class={darkStatPillClass}
                data-reveal
                style={getStaggerStyle(index, 340, 70)}
              >
                {item}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="page-band bg-[#211612] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div data-reveal>
        <SectionHeader
          title={t.home.sections.locationsTitle}
          intro={t.home.sections.locationsIntro}
          headingTag="h2"
          containerClass="max-w-2xl"
          titleClass="text-3xl font-semibold leading-tight text-white sm:text-4xl"
          introClass={darkSectionIntroClass}
        />
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          locations.map((location, index) => (
            <article
              class="homepage-card rounded-lg border border-white/12 bg-[#f7f0e7] p-5 text-[#15110f]"
              data-reveal
              style={getStaggerStyle(index, 0, 100)}
            >
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#8f241d]">
                {location.city}
              </p>
              <h3 class="mt-3 text-2xl font-semibold">{location.address}</h3>
              <p class="mt-3 text-sm font-medium text-[#5f5145]">
                {location.hours}
              </p>
              <LocationActions
                location={location}
                callLabel={t.cta.call}
                mapLabel={t.cta.map}
              />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-band bg-[#120f0d] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div
        class="overflow-hidden rounded-lg border border-white/12 bg-linear-to-br from-[#8f241d] via-[#6c1d18] to-[#31130f] p-6 sm:p-8 lg:p-10"
        data-reveal
      >
        <div class="grid gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-end">
          <SectionHeader
            eyebrow={homeSections.reservation.eyebrow}
            title={homeSections.reservation.title}
            intro={homeSections.reservation.intro}
            headingTag="h2"
            eyebrowClass="text-xs font-semibold uppercase tracking-[0.24em] text-[#f2d09a]"
            titleClass="mt-3 text-3xl font-semibold leading-tight text-white sm:text-4xl"
            introClass="mt-4 text-base leading-7 text-[#f7e9da]/82"
          >
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <CtaLink href={reservationPath} variant="goldHero">
                {t.cta.reserve}
              </CtaLink>
              <CtaLink
                href={brand.whatsappHref}
                variant="whiteOutlineHero"
                external={true}
              >
                {t.cta.whatsapp}
              </CtaLink>
            </div>
          </SectionHeader>

          <div class="grid gap-3">
            {
              homeSections.reservation.items.map((item, index) => (
                <p
                  class="rounded-lg border border-white/12 bg-black/16 px-4 py-4 text-base leading-7 text-[#f7e9da]"
                  data-reveal
                  style={getStaggerStyle(index, 120, 90)}
                >
                  <span class="mr-3 font-semibold text-[#f2d09a]">
                    {formatSequenceNumber(index)}
                  </span>
                  {item}
                </p>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const mediaQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const revealItems = Array.from(document.querySelectorAll("[data-reveal]"));

    if (mediaQuery.matches) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.18,
          rootMargin: "0px 0px -8% 0px",
        },
      );

      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</SiteLayout>
