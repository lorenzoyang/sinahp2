---
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import LocationActions from "../LocationActions.astro";
import CtaLink from "../ui/CtaLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import {
  brand,
  getPath,
  locations,
  type Locale,
} from "../../data/site";
import { homeImages } from "../../data/pageImages";
import { copy } from "../../data/copy";
import {
  getGalleryPhotoCountLabel,
  getGalleryPhotoTotal,
  getVisibleGalleryGroups,
} from "../../data/gallery";
import { getHomeSections } from "../../data/homeSections";
import {
  formatSequenceNumber,
  getStaggerStyle,
} from "../../utils/presentation";
import {
  cardClasses as sharedCardClasses,
  headingClasses,
  imageSizes,
  layoutClasses,
  mediaClasses as sharedMediaClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const homeSections = getHomeSections(locale);
const reservationPath = getPath(locale, "reservation");
const culturePath = getPath(locale, "culture");
const galleryPath = getPath(locale, "gallery");
const visibleGalleryGroups = getVisibleGalleryGroups().map((group) => ({
  ...group,
  label: t.gallery.categories[group.id],
  photoCountLabel: getGalleryPhotoCountLabel(group.photos.length, locale),
}));
const galleryPreviewGroups = visibleGalleryGroups.slice(0, 3);
const galleryTotalLabel = getGalleryPhotoCountLabel(
  getGalleryPhotoTotal(visibleGalleryGroups),
  locale,
);
const sectionClasses = {
  heroInner:
    "relative mx-auto flex min-h-[78svh] max-w-7xl items-end px-4 pb-10 pt-20 sm:min-h-[82svh] sm:px-6 lg:px-8",
};
const cardClasses = {
  dark: `homepage-card ${sharedCardClasses.dark}`,
  light: `homepage-card ${sharedCardClasses.light}`,
  location: `homepage-card ${sharedCardClasses.paperPanel} p-5`,
  reservationPanel:
    "overflow-hidden rounded-lg border border-white/12 bg-linear-to-br from-lacquer via-lacquer-mid to-ink-gradient p-6 sm:p-8 lg:p-10",
  galleryTile:
    "homepage-card relative min-h-44 overflow-hidden rounded-lg border border-white/12 bg-ink-panel",
};
const mediaClasses = {
  portraitFrame: sharedMediaClasses.portraitFrame,
  ritualFrame:
    "relative aspect-4/3 overflow-hidden rounded-lg border border-white/12 bg-ink-panel shadow-[0_24px_70px_rgba(0,0,0,0.24)]",
  photo: `homepage-photo ${sharedMediaClasses.absoluteImage}`,
  galleryPhoto: sharedMediaClasses.hoverImage,
};
const pillClasses = {
  heroProof:
    "min-w-0 rounded-md border border-white/12 bg-black/18 px-3 py-3 text-sm font-medium text-paper-soft backdrop-blur",
};
---

<SiteLayout locale={locale} page="home">
  <section class="homepage-hero relative overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={homeImages.hero}
        alt=""
        class="hero-image-drift absolute inset-0 h-full w-full object-cover"
        width={imageSizes.fullBleedHero.width}
        widths={imageSizes.fullBleedHero.widths}
        sizes={imageSizes.fullBleedHero.sizes}
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-linear-to-b from-ink/46 via-ink/64 to-ink"
      >
      </div>
      <div
        class="absolute inset-0 bg-linear-to-r from-ink/92 via-ink/56 to-transparent"
      >
      </div>
    </div>

    <div class={sectionClasses.heroInner}>
      <div class="w-full max-w-3xl min-w-0" data-reveal>
        <SectionHeader
          eyebrow={t.home.eyebrow}
          title={t.home.title}
          intro={t.home.intro}
          containerClass="w-full max-w-3xl min-w-0"
          titleClass="mt-5 max-w-full break-words text-4xl font-semibold leading-[0.98] text-white sm:text-6xl lg:text-7xl"
          introClass="mt-5 max-w-full break-words text-base leading-7 text-paper/88 sm:max-w-2xl sm:text-xl sm:leading-8"
        >
          <div class="mt-7 flex w-full min-w-0 flex-col gap-3 sm:flex-row">
            <CtaLink
              href={reservationPath}
              variant="goldHero"
              class="w-full sm:w-auto"
            >
              {t.cta.reserve}
            </CtaLink>
            <CtaLink
              href={culturePath}
              variant="whiteOutlineHero"
              class="w-full sm:w-auto"
            >
              {t.cta.culture}
            </CtaLink>
          </div>
          <div class="mt-8 grid w-full min-w-0 gap-2 sm:grid-cols-3">
            {
              t.home.proof.map((item, index) => (
                <p
                  class={pillClasses.heroProof}
                  data-reveal
                  style={getStaggerStyle(index, 120, 90)}
                >
                  {item}
                </p>
              ))
            }
          </div>
        </SectionHeader>
      </div>
    </div>
  </section>

  <section class={sharedSectionClasses.dark}>
    <div
      class={`${layoutClasses.container} grid gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-center`}
    >
      <div class="contents lg:block">
        <div class="order-1" data-reveal>
          <SectionHeader
            eyebrow={brand.publicName}
            title={t.home.sections.ritualTitle}
            intro={t.home.sections.ritualIntro}
            headingTag="h2"
            containerClass="max-w-3xl"
            eyebrowClass={headingClasses.darkEyebrow}
            titleClass={headingClasses.darkTitle}
            introClass="mt-4 max-w-2xl text-base leading-7 text-paper-soft/78"
          />
        </div>
        <div class="order-3 grid w-full min-w-0 gap-3 sm:grid-cols-2 lg:mt-8">
          {
            t.home.steps.map(([title, text], index) => (
              <article
                class:list={[cardClasses.dark, "p-5"]}
                data-reveal
                style={getStaggerStyle(index, 0, 90)}
              >
                <span class="text-sm font-semibold text-gold">
                  {formatSequenceNumber(index)}
                </span>
                <h3 class="mt-4 text-lg font-semibold text-white">{title}</h3>
                <p class="mt-3 text-sm leading-6 text-paper-soft/74">{text}</p>
              </article>
            ))
          }
        </div>
      </div>
      <div
        class:list={[mediaClasses.ritualFrame, "order-2 lg:order-0"]}
        data-reveal
        style="--reveal-delay:90ms"
      >
        <Image
          src={homeImages.howToEat}
          alt=""
          class={mediaClasses.photo}
          width={imageSizes.splitPanel.width}
          widths={imageSizes.splitPanel.widths}
          sizes={imageSizes.splitPanel.sizes}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class={sharedSectionClasses.paper}>
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-center"
    >
      <div class={mediaClasses.portraitFrame} data-reveal>
        <Image
          src={homeImages.premiumSpread}
          alt=""
          class={mediaClasses.photo}
          width={imageSizes.splitPanel.width}
          widths={imageSizes.splitPanel.widths}
          sizes={imageSizes.splitPanel.sizes}
          loading="lazy"
        />
      </div>
      <div data-reveal style="--reveal-delay:80ms">
        <SectionHeader
          eyebrow={brand.publicName}
          title={t.home.sections.premiumTitle}
          intro={homeSections.signatures.intro}
          headingTag="h2"
          eyebrowClass={headingClasses.lightEyebrow}
          titleClass={headingClasses.lightTitle}
          introClass={headingClasses.lightIntro}
        />
        <div class="mt-6 grid gap-3">
          {
            homeSections.signatures.items.map(([title, text], index) => (
              <article
                class:list={[cardClasses.light, "p-4"]}
                data-reveal
                style={getStaggerStyle(index, 140, 80)}
              >
                <span class="text-sm font-semibold text-lacquer">
                  {formatSequenceNumber(index)}
                </span>
                <h3 class="mt-3 text-lg font-semibold">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-brown-muted">{text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    galleryPreviewGroups.length > 0 && (
      <section class={sharedSectionClasses.inkBand}>
        <div
          class={`${layoutClasses.container} grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-center`}
        >
          <div data-reveal>
            <SectionHeader
              eyebrow={t.gallery.eyebrow}
              title={t.gallery.title}
              intro={t.gallery.intro}
              headingTag="h2"
              containerClass="max-w-3xl"
              eyebrowClass={headingClasses.darkEyebrow}
              titleClass={headingClasses.darkTitle}
              introClass={headingClasses.darkIntro}
            >
              <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
                <CtaLink
                  href={galleryPath}
                  variant="goldHero"
                  class="w-full sm:w-auto"
                >
                  {t.cta.gallery}
                </CtaLink>
                <p class="rounded-md border border-white/12 px-4 py-3 text-center text-sm font-semibold text-paper-soft/72 sm:text-left">
                  {galleryTotalLabel}
                </p>
              </div>
            </SectionHeader>
          </div>

          <a
            href={galleryPath}
            class="group focus-ring grid min-w-0 gap-3 rounded-lg sm:grid-cols-3 lg:grid-cols-[1.1fr_0.9fr]"
            aria-label={`${t.cta.gallery}: ${t.gallery.title}`}
            data-reveal
            style="--reveal-delay:100ms"
          >
            {galleryPreviewGroups.map((group, index) => (
              <figure
                class:list={[
                  cardClasses.galleryTile,
                  index === 0
                    ? "aspect-4/3 sm:col-span-3 lg:col-span-1 lg:row-span-2 lg:aspect-auto"
                    : "aspect-4/3",
                ]}
              >
                <Image
                  src={group.coverPhoto}
                  alt={`${brand.publicName} ${group.label}`}
                  class={mediaClasses.galleryPhoto}
                  width={imageSizes.card.width}
                  widths={imageSizes.card.widths}
                  sizes={imageSizes.card.sizes}
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-linear-to-t from-ink/84 via-ink/16 to-transparent" />
                <figcaption class="absolute inset-x-0 bottom-0 p-4">
                  <p class="text-lg font-semibold leading-tight text-white">
                    {group.label}
                  </p>
                  <p class="mt-1 text-sm font-medium text-paper-soft/74">
                    {group.photoCountLabel}
                  </p>
                </figcaption>
              </figure>
            ))}
          </a>
        </div>
      </section>
    )
  }

  <section class={sharedSectionClasses.footerDark}>
    <div class={layoutClasses.container}>
      <div data-reveal>
        <SectionHeader
          title={t.home.sections.locationsTitle}
          intro={t.home.sections.locationsIntro}
          headingTag="h2"
          containerClass="max-w-2xl"
          titleClass="text-3xl font-semibold leading-tight text-white sm:text-4xl"
          introClass={headingClasses.darkIntro}
        />
      </div>
      <div class="mt-8 grid gap-5 lg:grid-cols-[1.1fr_0.9fr] lg:items-stretch">
        <div class="grid gap-4 md:grid-cols-2">
          {
            locations.map((location, index) => (
              <article
                class={cardClasses.location}
                data-reveal
                style={getStaggerStyle(index, 0, 100)}
              >
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-lacquer">
                  {location.city}
                </p>
                <h3 class="mt-3 text-xl font-semibold sm:text-2xl">
                  {location.address}
                </h3>
                <p class="mt-3 text-sm font-medium text-brown-muted">
                  {location.hours}
                </p>
                <LocationActions
                  location={location}
                  callLabel={t.cta.call}
                  mapLabel={t.cta.map}
                />
              </article>
            ))
          }
        </div>

        <aside
          class={cardClasses.reservationPanel}
          data-reveal
          style="--reveal-delay:120ms"
        >
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-gold-soft">
            {homeSections.reservation.eyebrow}
          </p>
          <h3 class="mt-3 text-3xl font-semibold leading-tight text-white sm:text-4xl">
            {homeSections.reservation.title}
          </h3>
          <p class="mt-4 text-base leading-7 text-cream-soft/82">
            {homeSections.reservation.intro}
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
            <CtaLink href={reservationPath} variant="goldHero">
              {t.cta.reserve}
            </CtaLink>
            <CtaLink
              href={brand.whatsappHref}
              variant="whiteOutlineHero"
              external={true}
            >
              {t.cta.whatsapp}
            </CtaLink>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <script>
    import "../../scripts/homeReveal";
  </script>
</SiteLayout>
