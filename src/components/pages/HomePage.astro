---
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import LocationActions from "../LocationActions.astro";
import CtaLink from "../ui/CtaLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import {
  brand,
  getPath,
  images,
  locations,
  type Locale,
} from "../../data/site";
import { copy } from "../../data/copy";
import { getHomeSections } from "../../data/homeSections";
import {
  formatSequenceNumber,
  getStaggerStyle,
} from "../../utils/presentation";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const homeSections = getHomeSections(locale);
const reservationPath = getPath(locale, "reservation");
const culturePath = getPath(locale, "culture");
const sectionClasses = {
  shell: "page-band px-4 py-14 sm:px-6 lg:px-8",
  heroInner:
    "relative mx-auto flex min-h-[82svh] max-w-7xl items-end px-4 pb-10 pt-20 sm:px-6 lg:px-8",
  container: "mx-auto max-w-7xl",
};
const headingClasses = {
  darkEyebrow: "text-xs font-semibold uppercase tracking-[0.24em] text-gold",
  darkTitle: "mt-3 text-3xl font-semibold leading-tight text-white sm:text-4xl",
  darkIntro: "mt-4 text-base leading-7 text-paper-soft/76",
  lightEyebrow: "text-xs font-semibold uppercase tracking-[0.24em] text-lacquer",
  lightTitle: "mt-3 text-3xl font-semibold leading-tight sm:text-4xl",
  lightIntro: "mt-4 text-base leading-7 text-brown-text",
};
const cardClasses = {
  dark: "homepage-card rounded-lg border border-white/12 bg-white/5.5",
  light: "homepage-card rounded-lg border border-warm-line bg-white/70",
  lightSoft: "homepage-card rounded-lg border border-warm-line bg-white/72",
  location: "homepage-card rounded-lg border border-white/12 bg-paper p-5 text-ink",
  reservationPanel:
    "overflow-hidden rounded-lg border border-white/12 bg-linear-to-br from-lacquer via-lacquer-mid to-ink-gradient p-6 sm:p-8 lg:p-10",
};
const mediaClasses = {
  frame: "overflow-hidden rounded-lg",
  portraitPhoto: "homepage-photo aspect-4/5 h-full w-full object-cover",
  squarePhoto: "homepage-photo aspect-square h-full w-full object-cover",
};
const pillClasses = {
  heroProof:
    "rounded-md border border-white/12 bg-black/18 px-3 py-3 text-sm font-medium text-paper-soft backdrop-blur",
  lightPremium:
    "rounded-full border border-warm-line bg-white/72 px-4 py-2 text-sm font-medium text-brown-text",
  darkStat:
    "rounded-md border border-white/12 bg-black/18 px-4 py-3 text-sm font-medium text-paper-soft",
};
---

<SiteLayout locale={locale} page="home">
  <section class="homepage-hero relative overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={images.hero}
        alt=""
        class="hero-image-drift h-full w-full object-cover"
        width="1792"
        height="1024"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-linear-to-b from-ink/46 via-ink/64 to-ink"
      >
      </div>
      <div
        class="absolute inset-0 bg-linear-to-r from-ink/92 via-ink/56 to-transparent"
      >
      </div>
    </div>

    <div class={sectionClasses.heroInner}>
      <div class="max-w-3xl" data-reveal>
        <SectionHeader
          eyebrow={t.home.eyebrow}
          title={t.home.title}
          intro={t.home.intro}
          containerClass="max-w-3xl"
          titleClass="mt-5 text-5xl font-semibold leading-[0.95] text-white sm:text-6xl lg:text-7xl"
          introClass="mt-5 max-w-2xl text-lg leading-8 text-paper/88 sm:text-xl"
        >
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <CtaLink href={reservationPath} variant="goldHero">
              {t.cta.reserve}
            </CtaLink>
            <CtaLink href={culturePath} variant="whiteOutlineHero">
              {t.cta.culture}
            </CtaLink>
          </div>
          <div class="mt-8 grid gap-2 sm:grid-cols-3">
            {
              t.home.proof.map((item, index) => (
                <p
                  class={pillClasses.heroProof}
                  data-reveal
                  style={getStaggerStyle(index, 120, 90)}
                >
                  {item}
                </p>
              ))
            }
          </div>
        </SectionHeader>
      </div>
    </div>
  </section>

  <section class:list={[sectionClasses.shell, "bg-ink"]}>
    <div
      class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center"
    >
      <div data-reveal>
        <SectionHeader
          eyebrow={brand.publicName}
          title={t.home.sections.ritualTitle}
          intro={t.home.sections.ritualIntro}
          headingTag="h2"
          eyebrowClass={headingClasses.darkEyebrow}
          titleClass={headingClasses.darkTitle}
          introClass="mt-4 text-base leading-7 text-paper-soft/78"
        />
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          t.home.steps.map(([title, text], index) => (
            <article
              class:list={[cardClasses.dark, "p-5"]}
              data-reveal
              style={getStaggerStyle(index, 0, 90)}
            >
              <span class="text-sm font-semibold text-gold">
                {formatSequenceNumber(index)}
              </span>
              <h3 class="mt-4 text-xl font-semibold text-white">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-paper-soft/74">{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class:list={[sectionClasses.shell, "bg-paper text-ink"]}
  >
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-center"
    >
      <div class={mediaClasses.frame} data-reveal>
        <Image
          src={images.mealSpread}
          alt=""
          class={mediaClasses.portraitPhoto}
          width="1800"
          height="2250"
          loading="lazy"
        />
      </div>
      <div data-reveal style="--reveal-delay:80ms">
        <SectionHeader
          eyebrow={brand.publicName}
          title={t.home.sections.premiumTitle}
          intro={homeSections.signatures.intro}
          headingTag="h2"
          eyebrowClass={headingClasses.lightEyebrow}
          titleClass={headingClasses.lightTitle}
          introClass={headingClasses.lightIntro}
        />
        <div class="mt-6 grid gap-3">
          {
            homeSections.signatures.items.map(([title, text], index) => (
              <article
                class:list={[cardClasses.light, "p-4"]}
                data-reveal
                style={getStaggerStyle(index, 140, 80)}
              >
                <span class="text-sm font-semibold text-lacquer">
                  {formatSequenceNumber(index)}
                </span>
                <h3 class="mt-3 text-lg font-semibold">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-brown-muted">{text}</p>
              </article>
            ))
          }
        </div>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            t.home.premium.map((item, index) => (
              <p
                class={pillClasses.lightPremium}
                data-reveal
                style={getStaggerStyle(index, 340, 70)}
              >
                {item}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class:list={[sectionClasses.shell, "bg-ink-band"]}>
    <div class={sectionClasses.container}>
      <div data-reveal>
        <SectionHeader
          eyebrow={homeSections.occasions.eyebrow}
          title={homeSections.occasions.title}
          intro={homeSections.occasions.intro}
          headingTag="h2"
          containerClass="max-w-3xl"
          eyebrowClass={headingClasses.darkEyebrow}
          titleClass={headingClasses.darkTitle}
          introClass={headingClasses.darkIntro}
        />
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          homeSections.occasions.items.map(([title, text], index) => (
            <article
              class:list={[cardClasses.dark, "p-5"]}
              data-reveal
              style={getStaggerStyle(index, 0, 90)}
            >
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-gold">
                {formatSequenceNumber(index)}
              </p>
              <h3 class="mt-3 text-2xl font-semibold text-white">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-paper-soft/74">{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class:list={[sectionClasses.shell, "bg-paper-soft text-ink"]}
  >
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.84fr_1.16fr] lg:items-center"
    >
      <div class={mediaClasses.frame} data-reveal>
        <Image
          src={images.steamingSetup}
          alt=""
          class={mediaClasses.portraitPhoto}
          width="1800"
          height="2250"
          loading="lazy"
        />
      </div>
      <div data-reveal style="--reveal-delay:80ms">
        <SectionHeader
          eyebrow={homeSections.visit.eyebrow}
          title={homeSections.visit.title}
          intro={homeSections.visit.intro}
          headingTag="h2"
          eyebrowClass={headingClasses.lightEyebrow}
          titleClass={headingClasses.lightTitle}
          introClass={headingClasses.lightIntro}
        />
        <div class="mt-6 grid gap-3">
          {
            homeSections.visit.items.map((item, index) => (
              <p
                class:list={[
                  cardClasses.lightSoft,
                  "px-4 py-4 text-base leading-7 text-brown-text",
                ]}
                data-reveal
                style={getStaggerStyle(index, 140, 80)}
              >
                <span class="mr-3 font-semibold text-lacquer">
                  {formatSequenceNumber(index)}
                </span>
                {item}
              </p>
            ))
          }
        </div>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <CtaLink href={culturePath} variant="lightOutlineSmall">
            {t.cta.culture}
          </CtaLink>
          <CtaLink href={reservationPath} variant="redSmall">
            {t.cta.reserve}
          </CtaLink>
        </div>
      </div>
    </div>
  </section>

  <section class:list={[sectionClasses.shell, "bg-ink"]}>
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-center"
    >
      <div
        class="grid gap-4 sm:grid-cols-[1.1fr_0.9fr] lg:items-stretch"
        data-reveal
      >
        <div class={mediaClasses.frame}>
          <Image
            src={images.table}
            alt=""
            class={mediaClasses.portraitPhoto}
            width="1800"
            height="2250"
            loading="lazy"
          />
        </div>
        <div class="grid gap-4">
          <div class={mediaClasses.frame}>
            <Image
              src={images.culture}
              alt=""
              class={mediaClasses.squarePhoto}
              width="1800"
              height="1800"
              loading="lazy"
            />
          </div>
          <div class={mediaClasses.frame}>
            <Image
              src={images.ingredients}
              alt=""
              class={mediaClasses.squarePhoto}
              width="1800"
              height="1800"
              loading="lazy"
            />
          </div>
        </div>
      </div>
      <div data-reveal style="--reveal-delay:100ms">
        <SectionHeader
          eyebrow={homeSections.atmosphere.eyebrow}
          title={homeSections.atmosphere.title}
          intro={homeSections.atmosphere.intro}
          headingTag="h2"
          eyebrowClass={headingClasses.darkEyebrow}
          titleClass={headingClasses.darkTitle}
          introClass={headingClasses.darkIntro}
        />
        <div class="mt-6 grid gap-3">
          {
            homeSections.atmosphere.items.map((item, index) => (
              <p
                class:list={[
                  cardClasses.dark,
                  "px-4 py-4 text-base leading-7 text-paper-soft/82",
                ]}
                data-reveal
                style={getStaggerStyle(index, 160, 80)}
              >
                {item}
              </p>
            ))
          }
        </div>
        <div class="mt-6 grid gap-2 sm:grid-cols-2">
          {
            homeSections.atmosphere.stats.map((item, index) => (
              <p
                class={pillClasses.darkStat}
                data-reveal
                style={getStaggerStyle(index, 340, 70)}
              >
                {item}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class:list={[sectionClasses.shell, "bg-ink-band"]}>
    <div class={sectionClasses.container}>
      <div data-reveal>
        <SectionHeader
          title={t.home.sections.locationsTitle}
          intro={t.home.sections.locationsIntro}
          headingTag="h2"
          containerClass="max-w-2xl"
          titleClass="text-3xl font-semibold leading-tight text-white sm:text-4xl"
          introClass={headingClasses.darkIntro}
        />
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          locations.map((location, index) => (
            <article
              class={cardClasses.location}
              data-reveal
              style={getStaggerStyle(index, 0, 100)}
            >
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-lacquer">
                {location.city}
              </p>
              <h3 class="mt-3 text-2xl font-semibold">{location.address}</h3>
              <p class="mt-3 text-sm font-medium text-brown-muted">
                {location.hours}
              </p>
              <LocationActions
                location={location}
                callLabel={t.cta.call}
                mapLabel={t.cta.map}
              />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class:list={[sectionClasses.shell, "bg-ink-footer"]}>
    <div class={sectionClasses.container}>
      <div class={cardClasses.reservationPanel} data-reveal>
        <div class="grid gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-end">
          <SectionHeader
            eyebrow={homeSections.reservation.eyebrow}
            title={homeSections.reservation.title}
            intro={homeSections.reservation.intro}
            headingTag="h2"
            eyebrowClass="text-xs font-semibold uppercase tracking-[0.24em] text-gold-soft"
            titleClass="mt-3 text-3xl font-semibold leading-tight text-white sm:text-4xl"
            introClass="mt-4 text-base leading-7 text-cream-soft/82"
          >
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <CtaLink href={reservationPath} variant="goldHero">
                {t.cta.reserve}
              </CtaLink>
              <CtaLink
                href={brand.whatsappHref}
                variant="whiteOutlineHero"
                external={true}
              >
                {t.cta.whatsapp}
              </CtaLink>
            </div>
          </SectionHeader>

          <div class="grid gap-3">
            {
              homeSections.reservation.items.map((item, index) => (
                <p
                  class="rounded-lg border border-white/12 bg-black/16 px-4 py-4 text-base leading-7 text-cream-soft"
                  data-reveal
                  style={getStaggerStyle(index, 120, 90)}
                >
                  <span class="mr-3 font-semibold text-gold-soft">
                    {formatSequenceNumber(index)}
                  </span>
                  {item}
                </p>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import "../../scripts/homeReveal";
  </script>
</SiteLayout>
