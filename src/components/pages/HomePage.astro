---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { brand, getPath, images, locations, type Locale } from '../../data/site';
import { copy } from '../../data/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<SiteLayout locale={locale} page="home">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={images.hero}
        alt=""
        class="h-full w-full object-cover"
        width="1792"
        height="1024"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[#15110f]/45 via-[#15110f]/64 to-[#15110f]"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#15110f]/88 via-[#15110f]/44 to-transparent"></div>
    </div>

    <div class="relative mx-auto flex min-h-[78svh] max-w-7xl items-end px-4 pb-10 pt-20 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[#c7a062]">{t.home.eyebrow}</p>
        <h1 class="mt-5 text-5xl font-semibold leading-[0.95] text-white sm:text-6xl lg:text-7xl">
          {t.home.title}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-[#f7f0e7]/88 sm:text-xl">{t.home.intro}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            class="focus-ring inline-flex min-h-12 items-center justify-center rounded-md bg-[#c7a062] px-5 py-3 text-base font-semibold text-[#15110f] transition hover:bg-[#dfbd7d]"
            href={getPath(locale, 'reservation')}
          >
            {t.cta.reserve}
          </a>
          <a
            class="focus-ring inline-flex min-h-12 items-center justify-center rounded-md border border-white/28 px-5 py-3 text-base font-semibold text-white transition hover:bg-white/10"
            href={getPath(locale, 'culture')}
          >
            {t.cta.culture}
          </a>
        </div>
        <div class="mt-8 grid gap-2 sm:grid-cols-3">
          {
            t.home.proof.map((item) => (
              <p class="rounded-md border border-white/12 bg-black/18 px-3 py-3 text-sm font-medium text-[#efe3d5] backdrop-blur">
                {item}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="page-band bg-[#15110f] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#c7a062]">{brand.publicName}</p>
        <h2 class="mt-3 text-3xl font-semibold leading-tight text-white sm:text-4xl">{t.home.sections.ritualTitle}</h2>
        <p class="mt-4 text-base leading-7 text-[#efe3d5]/78">{t.home.sections.ritualIntro}</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          t.home.steps.map(([title, text], index) => (
            <article class="rounded-lg border border-white/12 bg-white/[0.055] p-5">
              <span class="text-sm font-semibold text-[#c7a062]">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 text-xl font-semibold text-white">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-[#efe3d5]/74">{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-band bg-[#f7f0e7] px-4 py-14 text-[#15110f] sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[1fr_0.82fr] lg:items-center">
      <div class="overflow-hidden rounded-lg">
        <img
          src={images.ingredients}
          alt=""
          class="aspect-[4/3] h-full w-full object-cover"
          width="1800"
          height="1200"
          loading="lazy"
        />
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#8f241d]">{t.home.sections.premiumTitle}</p>
        <h2 class="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">{t.home.title}</h2>
        <ul class="mt-6 grid gap-3">
          {
            t.home.premium.map((item) => (
              <li class="rounded-md border border-[#d8c8b5] bg-white/58 px-4 py-3 text-base leading-7">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="page-band bg-[#211612] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold leading-tight text-white sm:text-4xl">{t.home.sections.locationsTitle}</h2>
        <p class="mt-4 text-base leading-7 text-[#efe3d5]/76">{t.home.sections.locationsIntro}</p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          locations.map((location) => (
            <article class="rounded-lg border border-white/12 bg-[#f7f0e7] p-5 text-[#15110f]">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#8f241d]">{location.city}</p>
              <h3 class="mt-3 text-2xl font-semibold">{location.address}</h3>
              <p class="mt-3 text-sm font-medium text-[#5f5145]">{location.hours}</p>
              <div class="mt-5 flex flex-wrap gap-3">
                <a class="focus-ring rounded-md bg-[#8f241d] px-4 py-2 text-sm font-semibold text-white" href={`tel:${location.phone.replaceAll(' ', '')}`}>
                  {t.cta.call}
                </a>
                <a class="focus-ring rounded-md border border-[#c7a062] px-4 py-2 text-sm font-semibold text-[#15110f]" href={location.mapHref} target="_blank" rel="noreferrer">
                  {t.cta.map}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
