---
import HomeGalleryPreviewSection from "../home/HomeGalleryPreviewSection.astro";
import HomeHeroSection from "../home/HomeHeroSection.astro";
import HomeLocationsSection from "../home/HomeLocationsSection.astro";
import HomeRitualSection from "../home/HomeRitualSection.astro";
import HomeSignaturesSection from "../home/HomeSignaturesSection.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import type { Locale } from "../../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<SiteLayout locale={locale} page="home">
  <HomeHeroSection locale={locale} />
  <HomeRitualSection locale={locale} />
  <HomeSignaturesSection locale={locale} />
  <HomeGalleryPreviewSection locale={locale} />
  <HomeLocationsSection locale={locale} />

  <script>
    import "../../scripts/homeReveal";
  </script>
</SiteLayout>
