---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { brand, type Locale } from "../../data/site";
import { copy } from "../../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<SiteLayout
  locale={locale}
  page="privacy"
  title={`${t.privacy.title} | Sina Hotpot`}
  description={t.privacy.intro}
>
  <section class="bg-ink px-4 py-12 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow={brand.publicName}
      title={t.privacy.title}
      intro={t.privacy.intro}
      containerClass="mx-auto max-w-4xl"
    />
  </section>

  <section
    class="page-band bg-paper px-4 py-12 text-ink sm:px-6 lg:px-8"
  >
    <div class="mx-auto grid max-w-4xl gap-4">
      {
        t.privacy.sections.map(([title, text]) => (
          <article class="rounded-lg border border-warm-line bg-white/70 p-5">
            <h2 class="text-xl font-semibold">{title}</h2>
            <p class="mt-3 text-base leading-7 text-brown-body">{text}</p>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>
