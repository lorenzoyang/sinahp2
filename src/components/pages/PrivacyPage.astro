---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { brand, type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import type { PrivacySection } from "../../data/copy/types";
import {
  cardClasses,
  layoutClasses as sharedLayoutClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const privacySections = t.privacy.sections as readonly PrivacySection[];
const sectionClasses = {
  hero: sharedSectionClasses.heroDark,
  content: sharedSectionClasses.paperTight,
};
const layoutClasses = {
  content: `${sharedLayoutClasses.containerText} grid gap-4`,
};
const cardClass = cardClasses.lightPanel;
const textClasses = {
  updated: "text-sm font-semibold text-brown-muted",
  body: "text-base leading-7 text-brown-body",
  list: "mt-3 grid list-disc gap-2 pl-5 text-base leading-7 text-brown-body",
};
---

<SiteLayout
  locale={locale}
  page="privacy"
  title={`${t.privacy.title} | Sina Hotpot`}
  description={t.privacy.intro}
>
  <section class={sectionClasses.hero}>
    <SectionHeader
      eyebrow={brand.publicName}
      title={t.privacy.title}
      intro={t.privacy.intro}
      containerClass="mx-auto max-w-4xl"
    />
  </section>

  <section class={sectionClasses.content}>
    <div class={layoutClasses.content}>
      <p class={textClasses.updated}>{t.privacy.updated}</p>
      {
        privacySections.map((section) => (
          <article class={cardClass}>
            <h2 class="text-xl font-semibold">{section.title}</h2>
            <div class="mt-3 grid gap-3">
              {
                section.paragraphs.map((paragraph) => (
                  <p class={textClasses.body}>{paragraph}</p>
                ))
              }
            </div>
            {
              section.items && (
                <ul class={textClasses.list}>
                  {
                    section.items.map((item) => (
                      <li>{item}</li>
                    ))
                  }
                </ul>
              )
            }
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>
