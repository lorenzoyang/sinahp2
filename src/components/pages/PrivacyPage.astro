---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { brand, type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import type { PrivacySection } from "../../data/copy/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const privacySections = t.privacy.sections as readonly PrivacySection[];
const sectionClasses = {
  hero: "bg-ink px-4 py-12 sm:px-6 lg:px-8",
  content: "page-band bg-paper px-4 py-12 text-ink sm:px-6 lg:px-8",
};
const articleClasses = {
  privacy: "rounded-lg border border-warm-line bg-white/70 p-5",
  updated: "text-sm font-semibold text-brown-muted",
  body: "text-base leading-7 text-brown-body",
  list: "mt-3 grid list-disc gap-2 pl-5 text-base leading-7 text-brown-body",
};
---

<SiteLayout
  locale={locale}
  page="privacy"
  title={`${t.privacy.title} | Sina Hotpot`}
  description={t.privacy.intro}
>
  <section class={sectionClasses.hero}>
    <SectionHeader
      eyebrow={brand.publicName}
      title={t.privacy.title}
      intro={t.privacy.intro}
      containerClass="mx-auto max-w-4xl"
    />
  </section>

  <section
    class={sectionClasses.content}
  >
    <div class="mx-auto grid max-w-4xl gap-4">
      <p class={articleClasses.updated}>{t.privacy.updated}</p>
      {
        privacySections.map((section) => (
          <article class={articleClasses.privacy}>
            <h2 class="text-xl font-semibold">{section.title}</h2>
            <div class="mt-3 grid gap-3">
              {
                section.paragraphs.map((paragraph) => (
                  <p class={articleClasses.body}>{paragraph}</p>
                ))
              }
            </div>
            {
              section.items && (
                <ul class={articleClasses.list}>
                  {
                    section.items.map((item) => (
                      <li>{item}</li>
                    ))
                  }
                </ul>
              )
            }
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>
