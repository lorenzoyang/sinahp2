---
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import CtaLink from "../ui/CtaLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { getCultureTopicPath, getPath, type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import { getCultureTopicCards } from "../../data/cultureTopics";
import { cultureImages } from "../../data/pageImages";
import { getPageSeoMeta } from "../../data/seo";
import {
  cardClasses as sharedCardClasses,
  headingClasses,
  imageSizes,
  layoutClasses as sharedLayoutClasses,
  mediaClasses as sharedMediaClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const seoMeta = getPageSeoMeta(locale, "culture");
const topicCards = getCultureTopicCards(locale);
const sectionClasses = {
  hero: sharedSectionClasses.heroDark,
  dark: sharedSectionClasses.dark,
  inkBand: sharedSectionClasses.inkBand,
};
const layoutClasses = {
  heroContent: `${sharedLayoutClasses.container} grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end`,
  topicGrid: "mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-5",
  blockGrid: `${sharedLayoutClasses.container} grid gap-4 md:grid-cols-3`,
  etiquetteContent: sharedLayoutClasses.containerText,
  etiquetteList: "mt-6 grid gap-3",
};
const cardClasses = {
  dark: sharedCardClasses.dark,
  topic: `flex min-h-100 flex-col overflow-hidden ${sharedCardClasses.dark}`,
  etiquette: `${sharedCardClasses.dark} px-5 py-4 text-base leading-7 text-paper-soft/82`,
};
const mediaClasses = {
  heroFrame: "relative aspect-5/4 overflow-hidden rounded-lg",
  topicFrame: "relative aspect-4/3 w-full overflow-hidden",
  image: sharedMediaClasses.absoluteImage,
};
const textClasses = {
  topicKicker:
    "max-w-full wrap-break-word text-xs font-semibold uppercase leading-5 tracking-normal text-gold",
  topicTitle: "mt-3 text-xl font-semibold leading-tight text-white",
  topicSummary: "mt-3 flex-1 text-sm leading-6 text-paper-soft/76",
  blockTitle: "text-xl font-semibold text-white",
  blockBody: "mt-3 text-sm leading-6 text-paper-soft/76",
  etiquetteTitle: "text-3xl font-semibold text-white",
  etiquetteNumber: "mr-3 font-semibold text-gold",
};
---

<SiteLayout
  locale={locale}
  page="culture"
  title={seoMeta?.title}
  description={seoMeta?.description}
  socialImage={cultureImages.hero.src}
>
  <section class={sectionClasses.hero}>
    <div class={layoutClasses.heroContent}>
      <SectionHeader
        eyebrow={t.culture.eyebrow}
        title={t.culture.title}
        intro={t.culture.intro}
        containerClass="py-6"
      >
        <CtaLink
          href={getPath(locale, "reservation")}
          variant="gold"
          class="mt-7"
        >
          {t.cta.reserve}
        </CtaLink>
      </SectionHeader>
      <div class={mediaClasses.heroFrame}>
        <Image
          src={cultureImages.hero}
          alt=""
          class={mediaClasses.image}
          width={imageSizes.splitPanel.width}
          widths={imageSizes.splitPanel.widths}
          sizes={imageSizes.splitPanel.sizes}
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class={sectionClasses.inkBand}>
    <div class="mx-auto max-w-7xl">
      <SectionHeader
        eyebrow={t.culture.eyebrow}
        title={t.culture.title}
        intro={t.culture.intro}
        headingTag="h2"
        containerClass="max-w-3xl"
        eyebrowClass={headingClasses.darkEyebrow}
        titleClass={headingClasses.darkTitle}
        introClass={headingClasses.darkIntro}
      />
      <div class={layoutClasses.topicGrid}>
        {
          topicCards.map((topic) => (
            <article class={cardClasses.topic}>
              <div class={mediaClasses.topicFrame}>
                <Image
                  src={topic.image}
                  alt=""
                  class={mediaClasses.image}
                  width={imageSizes.card.width}
                  widths={imageSizes.card.widths}
                  sizes={imageSizes.card.sizes}
                  loading="lazy"
                />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <p class={textClasses.topicKicker}>
                  {topic.kicker}
                </p>
                <h3 class={textClasses.topicTitle}>
                  {topic.title}
                </h3>
                <p class={textClasses.topicSummary}>
                  {topic.summary}
                </p>
                <CtaLink
                  href={getCultureTopicPath(locale, topic.id)}
                  variant="goldSmall"
                  class="mt-5"
                >
                  {t.cta.learnMore}
                </CtaLink>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class={sectionClasses.dark}>
    <div class={layoutClasses.blockGrid}>
      {
        t.culture.blocks.map(([topicId, title, text]) => (
          <article class:list={[cardClasses.dark, "p-5"]}>
            <h2 class={textClasses.blockTitle}>{title}</h2>
            <p class={textClasses.blockBody}>{text}</p>
            <CtaLink
              href={getCultureTopicPath(locale, topicId)}
              variant="cultureOutline"
              class="mt-5"
            >
              {t.cta.learnMore}
            </CtaLink>
          </article>
        ))
      }
    </div>
  </section>

  <section class={sectionClasses.dark}>
    <div class={layoutClasses.etiquetteContent}>
      <h2 class={textClasses.etiquetteTitle}>
        {t.culture.etiquetteTitle}
      </h2>
      <div class={layoutClasses.etiquetteList}>
        {
          t.culture.etiquette.map((item, index) => (
            <p class={cardClasses.etiquette}>
              <span class={textClasses.etiquetteNumber}>{index + 1}</span>
              {item}
            </p>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
