---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CtaLink from "../ui/CtaLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import {
  getCultureTopicPath,
  getPath,
  images,
  type Locale,
} from "../../data/site";
import { copy } from "../../data/copy";
import { getCultureTopicCards } from "../../data/cultureTopics";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const topicCards = getCultureTopicCards(locale);
---

<SiteLayout
  locale={locale}
  page="culture"
  title={`${t.culture.title} | Sina Hotpot`}
  description={t.culture.intro}
>
  <section class="bg-ink px-4 py-12 sm:px-6 lg:px-8">
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end"
    >
      <SectionHeader
        eyebrow={t.culture.eyebrow}
        title={t.culture.title}
        intro={t.culture.intro}
        containerClass="py-6"
      >
        <CtaLink
          href={getPath(locale, "reservation")}
          variant="gold"
          class="mt-7"
        >
          {t.cta.reserve}
        </CtaLink>
      </SectionHeader>
      <div class="overflow-hidden rounded-lg">
        <img
          src={images.culture}
          alt=""
          class="aspect-5/4 h-full w-full object-cover"
          width="1800"
          height="1200"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="page-band bg-ink-band px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeader
        eyebrow={t.culture.whyTitle}
        title={t.culture.title}
        intro={t.culture.intro}
        headingTag="h2"
        containerClass="max-w-3xl"
        eyebrowClass="text-xs font-semibold uppercase tracking-[0.24em] text-gold"
        titleClass="mt-3 text-3xl font-semibold leading-tight text-white sm:text-4xl"
        introClass="mt-4 text-base leading-7 text-paper-soft/76"
      />
      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        {
          topicCards.map((topic) => (
            <article class="flex min-h-100 flex-col overflow-hidden rounded-lg border border-white/12 bg-white/5.5">
              <img
                src={topic.image}
                alt=""
                class="aspect-4/3 w-full object-cover"
                width="720"
                height="540"
                loading="lazy"
              />
              <div class="flex flex-1 flex-col p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">
                  {topic.kicker}
                </p>
                <h3 class="mt-3 text-xl font-semibold leading-tight text-white">
                  {topic.title}
                </h3>
                <p class="mt-3 flex-1 text-sm leading-6 text-paper-soft/76">
                  {topic.summary}
                </p>
                <CtaLink
                  href={getCultureTopicPath(locale, topic.id)}
                  variant="goldSmall"
                  class="mt-5"
                >
                  {t.cta.learnMore}
                </CtaLink>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-band bg-ink px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-4 md:grid-cols-3">
      {
        t.culture.blocks.map(([topicId, title, text]) => (
          <article class="rounded-lg border border-white/12 bg-white/5.5 p-5">
            <h2 class="text-xl font-semibold text-white">{title}</h2>
            <p class="mt-3 text-sm leading-6 text-paper-soft/76">{text}</p>
            <CtaLink
              href={getCultureTopicPath(locale, topicId)}
              variant="cultureOutline"
              class="mt-5"
            >
              {t.cta.learnMore}
            </CtaLink>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="page-band bg-paper px-4 py-14 text-ink sm:px-6 lg:px-8"
  >
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.85fr_1fr] lg:items-center"
    >
      <SectionHeader
        title={t.culture.whyTitle}
        headingTag="h2"
        titleClass="text-3xl font-semibold leading-tight sm:text-4xl"
      >
        <ul class="mt-6 grid gap-3">
          {
            t.culture.whyItems.map((item) => (
              <li class="rounded-md border border-warm-line bg-white/60 px-4 py-3 leading-7">
                {item}
              </li>
            ))
          }
        </ul>
      </SectionHeader>
      <div class="overflow-hidden rounded-lg">
        <img
          src={images.table}
          alt=""
          class="aspect-4/3 h-full w-full object-cover"
          width="1800"
          height="1200"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="page-band bg-ink px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-semibold text-white">
        {t.culture.etiquetteTitle}
      </h2>
      <div class="mt-6 grid gap-3">
        {
          t.culture.etiquette.map((item, index) => (
            <p class="rounded-lg border border-white/12 bg-white/5.5 px-5 py-4 text-base leading-7 text-paper-soft/82">
              <span class="mr-3 font-semibold text-gold">{index + 1}</span>
              {item}
            </p>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
