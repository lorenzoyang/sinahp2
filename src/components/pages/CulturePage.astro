---
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
  cultureTopicIds,
  getCultureTopicPath,
  getPath,
  images,
  type Locale,
} from "../../data/site";
import { copy } from "../../data/copy";
import { cultureTopics } from "../../data/cultureTopics";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const topicCards = cultureTopicIds.map((topicId) => ({
  id: topicId,
  image: cultureTopics[topicId].image,
  ...cultureTopics[topicId].content[locale],
}));
const blockTopicIds = ["ritual", "ingredients", "basics"] as const;
---

<SiteLayout
  locale={locale}
  page="culture"
  title={`${t.culture.title} | Sina Hotpot`}
  description={t.culture.intro}
>
  <section class="bg-[#15110f] px-4 py-12 sm:px-6 lg:px-8">
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end"
    >
      <div class="py-6">
        <p
          class="text-xs font-semibold uppercase tracking-[0.28em] text-[#c7a062]"
        >
          {t.culture.eyebrow}
        </p>
        <h1
          class="mt-4 text-4xl font-semibold leading-tight text-white sm:text-5xl"
        >
          {t.culture.title}
        </h1>
        <p class="mt-5 text-lg leading-8 text-[#efe3d5]/82">
          {t.culture.intro}
        </p>
        <a
          class="focus-ring mt-7 inline-flex min-h-12 items-center rounded-md bg-[#c7a062] px-5 py-3 font-semibold text-[#15110f]"
          href={getPath(locale, "reservation")}
        >
          {t.cta.reserve}
        </a>
      </div>
      <div class="overflow-hidden rounded-lg">
        <img
          src={images.culture}
          alt=""
          class="aspect-5/4 h-full w-full object-cover"
          width="1800"
          height="1200"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="page-band bg-[#211612] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold uppercase tracking-[0.24em] text-[#c7a062]"
        >
          {t.culture.whyTitle}
        </p>
        <h2
          class="mt-3 text-3xl font-semibold leading-tight text-white sm:text-4xl"
        >
          {t.culture.title}
        </h2>
        <p class="mt-4 text-base leading-7 text-[#efe3d5]/76">
          {t.culture.intro}
        </p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        {
          topicCards.map((topic) => (
            <article class="flex min-h-100 flex-col overflow-hidden rounded-lg border border-white/12 bg-white/5.5">
              <img
                src={topic.image}
                alt=""
                class="aspect-4/3 w-full object-cover"
                width="720"
                height="540"
                loading="lazy"
              />
              <div class="flex flex-1 flex-col p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#c7a062]">
                  {topic.kicker}
                </p>
                <h3 class="mt-3 text-xl font-semibold leading-tight text-white">
                  {topic.title}
                </h3>
                <p class="mt-3 flex-1 text-sm leading-6 text-[#efe3d5]/76">
                  {topic.summary}
                </p>
                <a
                  class="focus-ring mt-5 inline-flex min-h-11 items-center justify-center rounded-md bg-[#c7a062] px-4 py-2 text-sm font-semibold text-[#15110f] transition hover:bg-[#dfbd7d]"
                  href={getCultureTopicPath(locale, topic.id)}
                >
                  {t.cta.learnMore}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-band bg-[#15110f] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-4 md:grid-cols-3">
      {
        t.culture.blocks.map(([title, text], index) => (
          <article class="rounded-lg border border-white/12 bg-white/5.5 p-5">
            <h2 class="text-xl font-semibold text-white">{title}</h2>
            <p class="mt-3 text-sm leading-6 text-[#efe3d5]/76">{text}</p>
            <a
              class="focus-ring mt-5 inline-flex min-h-10 items-center rounded-md border border-[#c7a062] px-4 py-2 text-sm font-semibold text-[#f7f0e7] transition hover:bg-[#c7a062] hover:text-[#15110f]"
              href={getCultureTopicPath(locale, blockTopicIds[index])}
            >
              {t.cta.learnMore}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="page-band bg-[#f7f0e7] px-4 py-14 text-[#15110f] sm:px-6 lg:px-8"
  >
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.85fr_1fr] lg:items-center"
    >
      <div>
        <h2 class="text-3xl font-semibold leading-tight sm:text-4xl">
          {t.culture.whyTitle}
        </h2>
        <ul class="mt-6 grid gap-3">
          {
            t.culture.whyItems.map((item) => (
              <li class="rounded-md border border-[#d8c8b5] bg-white/60 px-4 py-3 leading-7">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="overflow-hidden rounded-lg">
        <img
          src={images.table}
          alt=""
          class="aspect-4/3 h-full w-full object-cover"
          width="1800"
          height="1200"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="page-band bg-[#15110f] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-semibold text-white">
        {t.culture.etiquetteTitle}
      </h2>
      <div class="mt-6 grid gap-3">
        {
          t.culture.etiquette.map((item, index) => (
            <p class="rounded-lg border border-white/12 bg-white/5.5 px-5 py-4 text-base leading-7 text-[#efe3d5]/82">
              <span class="mr-3 font-semibold text-[#c7a062]">{index + 1}</span>
              {item}
            </p>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
