---
import CtaLink from "./ui/CtaLink.astro";
import {
  getPhoneHref,
  type RestaurantLocation,
} from "../data/site";

interface Props {
  location: RestaurantLocation;
  callLabel: string;
  mapLabel: string;
  spacingClass?: "mt-5" | "mt-6";
}

const { location, callLabel, mapLabel, spacingClass = "mt-5" } = Astro.props;
---

<div class:list={[spacingClass, "flex flex-wrap gap-3"]}>
  <CtaLink href={getPhoneHref(location.phone)} variant="redSmall">
    {callLabel}
  </CtaLink>
  <CtaLink href={location.mapHref} variant="lightOutlineSmall" external>
    {mapLabel}
  </CtaLink>
</div>
