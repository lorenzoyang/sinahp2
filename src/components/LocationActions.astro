---
import {
  getPhoneHref,
  type RestaurantLocation,
} from "../data/site";

interface Props {
  location: RestaurantLocation;
  callLabel: string;
  mapLabel: string;
  spacingClass?: "mt-5" | "mt-6";
}

const { location, callLabel, mapLabel, spacingClass = "mt-5" } = Astro.props;
---

<div class:list={[spacingClass, "flex flex-wrap gap-3"]}>
  <a
    class="focus-ring rounded-md bg-[#8f241d] px-4 py-2 text-sm font-semibold text-white"
    href={getPhoneHref(location.phone)}
  >
    {callLabel}
  </a>
  <a
    class="focus-ring rounded-md border border-[#c7a062] px-4 py-2 text-sm font-semibold text-[#15110f]"
    href={location.mapHref}
    target="_blank"
    rel="noreferrer"
  >
    {mapLabel}
  </a>
</div>
