---
import { brand, getPath, locations, type Locale } from "../data/site";
import { copy } from "../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const successUrl = getPath(locale, "success");
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
---

<form
  id="reservation-form"
  class="grid gap-4 rounded-lg border border-white/12 bg-[#f7f0e7] p-4 text-[#15110f] shadow-2xl shadow-black/20 sm:p-6"
  data-success-url={successUrl}
  data-sending={t.reservation.sending}
  data-submit={t.reservation.submit}
  data-error={t.reservation.error}
  data-missing-key={t.reservation.missingKey}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Sina Hotpot Reservation Request" />
  <input type="hidden" name="from_name" value="Sina Hotpot Website" />
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    tabindex="-1"
    autocomplete="off"
  />

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="grid gap-2 text-sm font-semibold">
      {t.reservation.labels.name}
      <input
        class="focus-ring min-h-12 rounded-md border border-[#d8c8b5] bg-white px-3 text-base text-[#15110f]"
        name="name"
        autocomplete="name"
        placeholder={t.reservation.placeholders.name}
        required
      />
    </label>

    <label class="grid gap-2 text-sm font-semibold">
      {t.reservation.labels.phone}
      <input
        class="focus-ring min-h-12 rounded-md border border-[#d8c8b5] bg-white px-3 text-base text-[#15110f]"
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder={t.reservation.placeholders.phone}
        required
      />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <label class="grid gap-2 text-sm font-semibold">
      {t.reservation.labels.guests}
      <input
        class="focus-ring min-h-12 rounded-md border border-[#d8c8b5] bg-white px-3 text-base text-[#15110f]"
        name="guests"
        type="number"
        min="1"
        max="30"
        inputmode="numeric"
        required
      />
    </label>

    <label class="grid gap-2 text-sm font-semibold">
      {t.reservation.labels.date}
      <input
        id="reservation-date"
        class="focus-ring min-h-12 rounded-md border border-[#d8c8b5] bg-white px-3 text-base text-[#15110f]"
        name="date"
        type="date"
        required
      />
    </label>

    <label class="grid gap-2 text-sm font-semibold">
      {t.reservation.labels.time}
      <input
        class="focus-ring min-h-12 rounded-md border border-[#d8c8b5] bg-white px-3 text-base text-[#15110f]"
        name="time"
        type="time"
        required
      />
    </label>
  </div>

  <label class="grid gap-2 text-sm font-semibold">
    {t.reservation.labels.location}
    <select
      class="focus-ring min-h-12 rounded-md border border-[#d8c8b5] bg-white px-3 text-base text-[#15110f]"
      name="location"
      required
    >
      {
        locations.map((location) => (
          <option
            value={`${location.city} - ${location.address}`}
            selected={location.id === "prato"}
          >
            {location.city} - {location.address}
          </option>
        ))
      }
    </select>
  </label>

  <label class="grid gap-2 text-sm font-semibold">
    {t.reservation.labels.message}
    <textarea
      class="focus-ring min-h-28 rounded-md border border-[#d8c8b5] bg-white px-3 py-3 text-base text-[#15110f]"
      name="message"
      placeholder={t.reservation.placeholders.message}></textarea>
  </label>

  <p class="text-xs leading-5 text-[#5f5145]">
    {t.reservation.consent}
    <a
      class="font-semibold text-[#8f241d] underline decoration-[#c7a062] underline-offset-4"
      href={getPath(locale, "privacy")}
    >
      {t.reservation.privacyLink}
    </a>
  </p>

  <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-center">
    <p
      id="reservation-status"
      class="min-h-5 text-sm font-semibold text-[#8f241d]"
      aria-live="polite"
    >
    </p>
    <button
      id="reservation-submit"
      class="focus-ring min-h-12 rounded-md bg-[#8f241d] px-5 py-3 text-base font-semibold text-white transition hover:bg-[#701b16]"
      type="submit"
    >
      {t.reservation.submit}
    </button>
  </div>

  <p class="text-xs leading-5 text-[#5f5145]">
    {brand.publicName} - {brand.email} - {brand.whatsapp}
  </p>
</form>

<script>
  const form = document.getElementById(
    "reservation-form",
  ) as HTMLFormElement | null;
  const status = document.getElementById("reservation-status");
  const submit = document.getElementById(
    "reservation-submit",
  ) as HTMLButtonElement | null;
  const dateInput = document.getElementById(
    "reservation-date",
  ) as HTMLInputElement | null;

  if (dateInput) {
    dateInput.min = new Date().toISOString().slice(0, 10);
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form.reportValidity() || !submit || !status) {
      return;
    }

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());
    const labels = form.dataset;

    if (!payload.access_key) {
      status.textContent = labels.missingKey ?? "";
      return;
    }

    submit.disabled = true;
    submit.textContent = labels.sending ?? submit.textContent;
    status.textContent = "";

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(payload),
      });
      const result = await response.json();

      if (response.ok && result.success) {
        window.location.href = labels.successUrl ?? "/reservation-success/";
        return;
      }

      status.textContent = result.message || labels.error || "";
    } catch {
      status.textContent = labels.error ?? "";
    } finally {
      submit.disabled = false;
      submit.textContent = labels.submit ?? submit.textContent;
    }
  });
</script>
