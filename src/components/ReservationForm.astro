---
import {
  PUBLIC_WEB3FORMS_ACCESS_KEY,
  PUBLIC_WEB3FORMS_CAPTCHA_ENABLED,
} from "astro:env/client";
import {
  brand,
  getLocationLabel,
  getPath,
  locations,
  type Locale,
} from "../data/site";
import { copy } from "../data/copy";
import { getReservationTimeSlots } from "../utils/reservation";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const successUrl = getPath(locale, "success");
const accessKey = PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const captchaEnabled = PUBLIC_WEB3FORMS_CAPTCHA_ENABLED;
const privacyPath = getPath(locale, "privacy");

const locationOptions = locations.map((location) => ({
  ...location,
  label: getLocationLabel(location),
  timeSlots: getReservationTimeSlots(location.reservationTimeRanges),
}));
const layoutClasses = {
  root: "grid min-w-0 gap-4 rounded-lg border border-white/12 bg-paper p-4 text-ink shadow-2xl shadow-black/20 sm:p-6",
  rowTwo: "grid min-w-0 gap-4 sm:grid-cols-2",
  rowThree: "grid min-w-0 gap-4 sm:grid-cols-3",
  submitRow: "grid min-w-0 gap-3 sm:grid-cols-[1fr_auto] sm:items-center",
};
const fieldClasses = {
  label: "grid min-w-0 gap-2 text-sm font-semibold",
  consent: "flex items-start gap-3 text-xs leading-5 text-brown-muted",
  checkbox:
    "focus-ring mt-1 size-4 shrink-0 rounded border border-warm-line bg-white accent-lacquer [color-scheme:light]",
  input:
    "focus-ring min-h-12 w-full min-w-0 rounded-md border border-warm-line bg-white px-3 text-base text-ink",
  textarea:
    "focus-ring min-h-28 w-full min-w-0 rounded-md border border-warm-line bg-white px-3 py-3 text-base text-ink",
  captcha: "min-h-[78px] overflow-visible",
};
const textClasses = {
  finePrint: "text-xs leading-5 text-brown-muted",
  privacyLink:
    "font-semibold text-lacquer underline decoration-gold underline-offset-4",
  status: "min-h-5 text-sm font-semibold text-lacquer",
  hint: "text-xs font-normal leading-5 text-brown-muted",
};
const actionClasses = {
  submitButton:
    "focus-ring min-h-12 rounded-md bg-lacquer px-5 py-3 text-base font-semibold text-white transition hover:bg-lacquer-hover",
};
---

<form
  class={layoutClasses.root}
  data-reservation-form
  data-success-url={successUrl}
  data-sending={t.reservation.sending}
  data-submit={t.reservation.submit}
  data-error={t.reservation.error}
  data-missing-key={t.reservation.missingKey}
  data-captcha-required={t.reservation.captchaRequired}
  data-captcha-enabled={captchaEnabled ? "true" : "false"}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Sina Hotpot Reservation Request" />
  <input type="hidden" name="from_name" value="Sina Hotpot Website" />
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    tabindex="-1"
    autocomplete="off"
  />

  <div class={layoutClasses.rowTwo}>
    <label class={fieldClasses.label}>
      {t.reservation.labels.name}
      <input
        class={fieldClasses.input}
        name="name"
        autocomplete="name"
        placeholder={t.reservation.placeholders.name}
        required
      />
    </label>

    <label class={fieldClasses.label}>
      {t.reservation.labels.phone}
      <input
        class={fieldClasses.input}
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder={t.reservation.placeholders.phone}
        required
      />
    </label>
  </div>

  <label class={fieldClasses.label}>
    {t.reservation.labels.location}
    <select
      class={fieldClasses.input}
      name="location"
      required
      data-reservation-location
    >
      <option value="" disabled selected>
        {t.reservation.placeholders.location}
      </option>
      {
        locationOptions.map((location) => (
          <option
            value={location.label}
            data-time-slots={JSON.stringify(location.timeSlots)}
          >
            {location.label}
          </option>
        ))
      }
    </select>
  </label>

  <div class={layoutClasses.rowThree}>
    <label class={fieldClasses.label}>
      {t.reservation.labels.guests}
      <input
        class={fieldClasses.input}
        name="guests"
        type="number"
        min="1"
        max="30"
        inputmode="numeric"
        required
      />
    </label>

    <label class={fieldClasses.label}>
      {t.reservation.labels.date}
      <input
        class={fieldClasses.input}
        name="date"
        type="date"
        data-reservation-date
        required
      />
    </label>

    <label class={fieldClasses.label}>
      {t.reservation.labels.time}
      <span class={textClasses.hint}>
        {t.reservation.hints.time}
      </span>
      <select
        class={fieldClasses.input}
        name="time"
        required
        data-reservation-time
        data-placeholder={t.reservation.labels.time}
      >
        <option value="" disabled selected>
          {t.reservation.labels.time}
        </option>
      </select>
    </label>
  </div>

  <label class={fieldClasses.label}>
    {t.reservation.labels.message}
    <textarea
      class={fieldClasses.textarea}
      name="message"
      placeholder={t.reservation.placeholders.message}></textarea>
  </label>

  <label class={fieldClasses.consent}>
    <input
      class={fieldClasses.checkbox}
      type="checkbox"
      name="privacy_acknowledgement"
      value="accepted"
      required
    />
    <span>{t.reservation.consentPrefix}<a class={textClasses.privacyLink} href={privacyPath}>{t.reservation.privacyLink}</a>{t.reservation.consentSuffix}</span>
  </label>

  {
    captchaEnabled && (
      <div
        class:list={[fieldClasses.captcha, "h-captcha"]}
        data-captcha="true"
      >
      </div>
    )
  }

  <div class={layoutClasses.submitRow}>
    <p
      class={textClasses.status}
      aria-live="polite"
      data-reservation-status
    >
    </p>
    <button
      class={actionClasses.submitButton}
      type="submit"
      data-reservation-submit
    >
      {t.reservation.submit}
    </button>
  </div>

  <p class={textClasses.finePrint}>
    {brand.publicName} - {brand.email} - {brand.whatsapp}
  </p>
</form>

<script>
  import "../scripts/reservationForm";
</script>

{
  captchaEnabled && (
    <script
      is:inline
      src="https://web3forms.com/client/script.js"
      async
      defer
    ></script>
  )
}
