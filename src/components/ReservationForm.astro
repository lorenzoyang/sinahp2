---
import { PUBLIC_WEB3FORMS_ACCESS_KEY } from "astro:env/client";
import {
  brand,
  getLocationLabel,
  getPath,
  locations,
  type Locale,
} from "../data/site";
import { copy } from "../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const successUrl = getPath(locale, "success");
const accessKey = PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const labelClass = "grid gap-2 text-sm font-semibold";
const inputClass =
  "focus-ring min-h-12 rounded-md border border-warm-line bg-white px-3 text-base text-ink";
const textareaClass =
  "focus-ring min-h-28 rounded-md border border-warm-line bg-white px-3 py-3 text-base text-ink";
const finePrintClass = "text-xs leading-5 text-brown-muted";
const privacyPath = getPath(locale, "privacy");
const locationOptions = locations.map((location) => ({
  ...location,
  label: getLocationLabel(location),
}));
---

<form
  id="reservation-form"
  class="grid gap-4 rounded-lg border border-white/12 bg-paper p-4 text-ink shadow-2xl shadow-black/20 sm:p-6"
  data-success-url={successUrl}
  data-sending={t.reservation.sending}
  data-submit={t.reservation.submit}
  data-error={t.reservation.error}
  data-missing-key={t.reservation.missingKey}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Sina Hotpot Reservation Request" />
  <input type="hidden" name="from_name" value="Sina Hotpot Website" />
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    tabindex="-1"
    autocomplete="off"
  />

  <div class="grid gap-4 sm:grid-cols-2">
    <label class={labelClass}>
      {t.reservation.labels.name}
      <input
        class={inputClass}
        name="name"
        autocomplete="name"
        placeholder={t.reservation.placeholders.name}
        required
      />
    </label>

    <label class={labelClass}>
      {t.reservation.labels.phone}
      <input
        class={inputClass}
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder={t.reservation.placeholders.phone}
        required
      />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <label class={labelClass}>
      {t.reservation.labels.guests}
      <input
        class={inputClass}
        name="guests"
        type="number"
        min="1"
        max="30"
        inputmode="numeric"
        required
      />
    </label>

    <label class={labelClass}>
      {t.reservation.labels.date}
      <input
        id="reservation-date"
        class={inputClass}
        name="date"
        type="date"
        required
      />
    </label>

    <label class={labelClass}>
      {t.reservation.labels.time}
      <input
        class={inputClass}
        name="time"
        type="time"
        required
      />
    </label>
  </div>

  <label class={labelClass}>
    {t.reservation.labels.location}
    <select class={inputClass} name="location" required>
      {
        locationOptions.map((location) => (
          <option value={location.label} selected={location.id === "firenze"}>
            {location.label}
          </option>
        ))
      }
    </select>
  </label>

  <label class={labelClass}>
    {t.reservation.labels.message}
    <textarea
      class={textareaClass}
      name="message"
      placeholder={t.reservation.placeholders.message}></textarea>
  </label>

  <p class={finePrintClass}>
    {t.reservation.consent}
    <a
      class="font-semibold text-lacquer underline decoration-gold underline-offset-4"
      href={privacyPath}
    >
      {t.reservation.privacyLink}
    </a>
  </p>

  <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-center">
    <p
      id="reservation-status"
      class="min-h-5 text-sm font-semibold text-lacquer"
      aria-live="polite"
    >
    </p>
    <button
      id="reservation-submit"
      class="focus-ring min-h-12 rounded-md bg-lacquer px-5 py-3 text-base font-semibold text-white transition hover:bg-lacquer-hover"
      type="submit"
    >
      {t.reservation.submit}
    </button>
  </div>

  <p class={finePrintClass}>
    {brand.publicName} - {brand.email} - {brand.whatsapp}
  </p>
</form>

<script>
  import "../scripts/reservationForm";
</script>
