---
import {
  brand,
  getLocationLabel,
  getPath,
  locations,
  type Locale,
} from "../data/site";
import { copy } from "../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const successUrl = getPath(locale, "success");
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const labelClass = "grid gap-2 text-sm font-semibold";
const inputClass =
  "focus-ring min-h-12 rounded-md border border-[#d8c8b5] bg-white px-3 text-base text-[#15110f]";
const textareaClass =
  "focus-ring min-h-28 rounded-md border border-[#d8c8b5] bg-white px-3 py-3 text-base text-[#15110f]";
const finePrintClass = "text-xs leading-5 text-[#5f5145]";
const privacyPath = getPath(locale, "privacy");
const locationOptions = locations.map((location) => ({
  ...location,
  label: getLocationLabel(location),
}));
---

<form
  id="reservation-form"
  class="grid gap-4 rounded-lg border border-white/12 bg-[#f7f0e7] p-4 text-[#15110f] shadow-2xl shadow-black/20 sm:p-6"
  data-success-url={successUrl}
  data-sending={t.reservation.sending}
  data-submit={t.reservation.submit}
  data-error={t.reservation.error}
  data-missing-key={t.reservation.missingKey}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Sina Hotpot Reservation Request" />
  <input type="hidden" name="from_name" value="Sina Hotpot Website" />
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    tabindex="-1"
    autocomplete="off"
  />

  <div class="grid gap-4 sm:grid-cols-2">
    <label class={labelClass}>
      {t.reservation.labels.name}
      <input
        class={inputClass}
        name="name"
        autocomplete="name"
        placeholder={t.reservation.placeholders.name}
        required
      />
    </label>

    <label class={labelClass}>
      {t.reservation.labels.phone}
      <input
        class={inputClass}
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder={t.reservation.placeholders.phone}
        required
      />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class={labelClass}>
      {t.reservation.labels.guests}
      <input
        class={inputClass}
        name="guests"
        type="number"
        min="1"
        max="30"
        inputmode="numeric"
        required
      />
    </label>

    <label class={labelClass}>
      {t.reservation.labels.date}
      <input
        id="reservation-date"
        class={inputClass}
        name="date"
        type="date"
        required
      />
    </label>

  </div>

  <label class={labelClass}>
    {t.reservation.labels.location}
    <select
      class={inputClass}
      name="location"
      required
    >
      {
        locationOptions.map((location) => (
          <option
            value={location.label}
            selected={location.id === "prato"}
          >
            {location.label}
          </option>
        ))
      }
    </select>
  </label>

  <label class={labelClass}>
    {t.reservation.labels.message}
    <textarea
      class={textareaClass}
      name="message"
      placeholder={t.reservation.placeholders.message}></textarea>
  </label>

  <p class={finePrintClass}>
    {t.reservation.consent}
    <a
      class="font-semibold text-[#8f241d] underline decoration-[#c7a062] underline-offset-4"
      href={privacyPath}
    >
      {t.reservation.privacyLink}
    </a>
  </p>

  <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-center">
    <p
      id="reservation-status"
      class="min-h-5 text-sm font-semibold text-[#8f241d]"
      aria-live="polite"
    >
    </p>
    <button
      id="reservation-submit"
      class="focus-ring min-h-12 rounded-md bg-[#8f241d] px-5 py-3 text-base font-semibold text-white transition hover:bg-[#701b16]"
      type="submit"
    >
      {t.reservation.submit}
    </button>
  </div>

  <p class={finePrintClass}>
    {brand.publicName} - {brand.email} - {brand.whatsapp}
  </p>
</form>

<script>
  type Web3FormsResponse = {
    success?: boolean;
    message?: string;
  };

  const WEB3FORMS_ENDPOINT = "https://api.web3forms.com/submit";

  const form = document.getElementById(
    "reservation-form",
  ) as HTMLFormElement | null;
  const status = document.getElementById("reservation-status");
  const submit = document.getElementById(
    "reservation-submit",
  ) as HTMLButtonElement | null;
  const dateInput = document.getElementById(
    "reservation-date",
  ) as HTMLInputElement | null;

  function getTodayDateValue() {
    return new Date().toISOString().slice(0, 10);
  }

  function getPayload(form: HTMLFormElement) {
    return Object.fromEntries(new FormData(form).entries()) as Record<
      string,
      FormDataEntryValue
    >;
  }

  function showStatus(message: string) {
    if (status) {
      status.textContent = message;
    }
  }

  function setSubmitState(isSending: boolean) {
    if (!submit || !form) {
      return;
    }

    submit.disabled = isSending;
    submit.textContent = isSending
      ? (form.dataset.sending ?? submit.textContent)
      : (form.dataset.submit ?? submit.textContent);
  }

  async function submitReservation(payload: Record<string, FormDataEntryValue>) {
    const response = await fetch(WEB3FORMS_ENDPOINT, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: JSON.stringify(payload),
    });
    const result = (await response.json()) as Web3FormsResponse;

    return { response, result };
  }

  if (dateInput) {
    dateInput.min = getTodayDateValue();
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form.reportValidity() || !submit || !status) {
      return;
    }

    const payload = getPayload(form);
    const labels = form.dataset;

    if (!payload.access_key) {
      showStatus(labels.missingKey ?? "");
      return;
    }

    setSubmitState(true);
    showStatus("");

    try {
      const { response, result } = await submitReservation(payload);

      if (response.ok && result.success) {
        window.location.href = labels.successUrl ?? "/reservation-success/";
        return;
      }

      showStatus(result.message || labels.error || "");
    } catch {
      showStatus(labels.error ?? "");
    } finally {
      setSubmitState(false);
    }
  });
</script>
