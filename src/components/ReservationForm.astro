---
import { PUBLIC_WEB3FORMS_ACCESS_KEY } from "astro:env/client";
import {
  brand,
  getLocationLabel,
  getPath,
  locations,
  type Locale,
} from "../data/site";
import { copy } from "../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const successUrl = getPath(locale, "success");
const accessKey = PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const privacyPath = getPath(locale, "privacy");
const locationOptions = locations.map((location) => ({
  ...location,
  label: getLocationLabel(location),
}));
const formClasses = {
  root: "grid gap-4 rounded-lg border border-white/12 bg-paper p-4 text-ink shadow-2xl shadow-black/20 sm:p-6",
  rowTwo: "grid gap-4 sm:grid-cols-2",
  rowThree: "grid gap-4 sm:grid-cols-3",
  submitRow: "grid gap-3 sm:grid-cols-[1fr_auto] sm:items-center",
  label: "grid gap-2 text-sm font-semibold",
  input:
    "focus-ring min-h-12 rounded-md border border-warm-line bg-white px-3 text-base text-ink",
  textarea:
    "focus-ring min-h-28 rounded-md border border-warm-line bg-white px-3 py-3 text-base text-ink",
  finePrint: "text-xs leading-5 text-brown-muted",
  privacyLink:
    "font-semibold text-lacquer underline decoration-gold underline-offset-4",
  status: "min-h-5 text-sm font-semibold text-lacquer",
  submitButton:
    "focus-ring min-h-12 rounded-md bg-lacquer px-5 py-3 text-base font-semibold text-white transition hover:bg-lacquer-hover",
};
---

<form
  id="reservation-form"
  class={formClasses.root}
  data-success-url={successUrl}
  data-sending={t.reservation.sending}
  data-submit={t.reservation.submit}
  data-error={t.reservation.error}
  data-missing-key={t.reservation.missingKey}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Sina Hotpot Reservation Request" />
  <input type="hidden" name="from_name" value="Sina Hotpot Website" />
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    tabindex="-1"
    autocomplete="off"
  />

  <div class={formClasses.rowTwo}>
    <label class={formClasses.label}>
      {t.reservation.labels.name}
      <input
        class={formClasses.input}
        name="name"
        autocomplete="name"
        placeholder={t.reservation.placeholders.name}
        required
      />
    </label>

    <label class={formClasses.label}>
      {t.reservation.labels.phone}
      <input
        class={formClasses.input}
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder={t.reservation.placeholders.phone}
        required
      />
    </label>
  </div>

  <div class={formClasses.rowThree}>
    <label class={formClasses.label}>
      {t.reservation.labels.guests}
      <input
        class={formClasses.input}
        name="guests"
        type="number"
        min="1"
        max="30"
        inputmode="numeric"
        required
      />
    </label>

    <label class={formClasses.label}>
      {t.reservation.labels.date}
      <input
        id="reservation-date"
        class={formClasses.input}
        name="date"
        type="date"
        required
      />
    </label>

    <label class={formClasses.label}>
      {t.reservation.labels.time}
      <input
        class={formClasses.input}
        name="time"
        type="time"
        required
      />
    </label>
  </div>

  <label class={formClasses.label}>
    {t.reservation.labels.location}
    <select class={formClasses.input} name="location" required>
      {
        locationOptions.map((location) => (
          <option value={location.label} selected={location.id === "firenze"}>
            {location.label}
          </option>
        ))
      }
    </select>
  </label>

  <label class={formClasses.label}>
    {t.reservation.labels.message}
    <textarea
      class={formClasses.textarea}
      name="message"
      placeholder={t.reservation.placeholders.message}></textarea>
  </label>

  <p class={formClasses.finePrint}>
    {t.reservation.consent}
    <a
      class={formClasses.privacyLink}
      href={privacyPath}
    >
      {t.reservation.privacyLink}
    </a>
  </p>

  <div class={formClasses.submitRow}>
    <p
      id="reservation-status"
      class={formClasses.status}
      aria-live="polite"
    >
    </p>
    <button
      id="reservation-submit"
      class={formClasses.submitButton}
      type="submit"
    >
      {t.reservation.submit}
    </button>
  </div>

  <p class={formClasses.finePrint}>
    {brand.publicName} - {brand.email} - {brand.whatsapp}
  </p>
</form>

<script>
  import "../scripts/reservationForm";
</script>
