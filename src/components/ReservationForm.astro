---
import {
  PUBLIC_WEB3FORMS_ACCESS_KEY,
  PUBLIC_WEB3FORMS_CAPTCHA_ENABLED,
} from "astro:env/client";
import {
  brand,
  getLocationLabel,
  getPath,
  locations,
  type Locale,
  type RestaurantLocation,
} from "../data/site";
import { copy } from "../data/copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const successUrl = getPath(locale, "success");
const accessKey = PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const captchaEnabled = PUBLIC_WEB3FORMS_CAPTCHA_ENABLED;
const privacyPath = getPath(locale, "privacy");
const defaultLocationId = "firenze";
const reservationSlotIntervalMinutes = 30;

function timeToMinutes(time: string) {
  const [hours = "0", minutes = "0"] = time.split(":");

  return Number(hours) * 60 + Number(minutes);
}

function minutesToTime(minutes: number) {
  const normalizedMinutes = minutes % (24 * 60);
  const hours = Math.floor(normalizedMinutes / 60);
  const minute = normalizedMinutes % 60;

  return `${String(hours).padStart(2, "0")}:${String(minute).padStart(2, "0")}`;
}

function getReservationTimeSlots(
  ranges: RestaurantLocation["reservationTimeRanges"],
) {
  return ranges.flatMap(({ start, end }) => {
    const startMinutes = timeToMinutes(start);
    const endMinutes = timeToMinutes(end);
    const adjustedEndMinutes =
      endMinutes <= startMinutes ? endMinutes + 24 * 60 : endMinutes;
    const slots: string[] = [];

    for (
      let minutes = startMinutes;
      minutes < adjustedEndMinutes;
      minutes += reservationSlotIntervalMinutes
    ) {
      slots.push(minutesToTime(minutes));
    }

    return slots;
  });
}

const locationOptions = locations.map((location) => ({
  ...location,
  label: getLocationLabel(location),
  timeSlots: getReservationTimeSlots(location.reservationTimeRanges),
}));
const formClasses = {
  root: "grid gap-4 rounded-lg border border-white/12 bg-paper p-4 text-ink shadow-2xl shadow-black/20 sm:p-6",
  rowTwo: "grid gap-4 sm:grid-cols-2",
  rowThree: "grid gap-4 sm:grid-cols-3",
  submitRow: "grid gap-3 sm:grid-cols-[1fr_auto] sm:items-center",
  label: "grid gap-2 text-sm font-semibold",
  input:
    "focus-ring min-h-12 rounded-md border border-warm-line bg-white px-3 text-base text-ink",
  textarea:
    "focus-ring min-h-28 rounded-md border border-warm-line bg-white px-3 py-3 text-base text-ink",
  finePrint: "text-xs leading-5 text-brown-muted",
  privacyLink:
    "font-semibold text-lacquer underline decoration-gold underline-offset-4",
  captcha: "min-h-[78px] overflow-visible",
  status: "min-h-5 text-sm font-semibold text-lacquer",
  submitButton:
    "focus-ring min-h-12 rounded-md bg-lacquer px-5 py-3 text-base font-semibold text-white transition hover:bg-lacquer-hover",
};
---

<form
  id="reservation-form"
  class={formClasses.root}
  data-success-url={successUrl}
  data-sending={t.reservation.sending}
  data-submit={t.reservation.submit}
  data-error={t.reservation.error}
  data-missing-key={t.reservation.missingKey}
  data-captcha-required={t.reservation.captchaRequired}
  data-captcha-enabled={captchaEnabled ? "true" : "false"}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Sina Hotpot Reservation Request" />
  <input type="hidden" name="from_name" value="Sina Hotpot Website" />
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    tabindex="-1"
    autocomplete="off"
  />

  <div class={formClasses.rowTwo}>
    <label class={formClasses.label}>
      {t.reservation.labels.name}
      <input
        class={formClasses.input}
        name="name"
        autocomplete="name"
        placeholder={t.reservation.placeholders.name}
        required
      />
    </label>

    <label class={formClasses.label}>
      {t.reservation.labels.phone}
      <input
        class={formClasses.input}
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder={t.reservation.placeholders.phone}
        required
      />
    </label>
  </div>

  <div class={formClasses.rowThree}>
    <label class={formClasses.label}>
      {t.reservation.labels.guests}
      <input
        class={formClasses.input}
        name="guests"
        type="number"
        min="1"
        max="30"
        inputmode="numeric"
        required
      />
    </label>

    <label class={formClasses.label}>
      {t.reservation.labels.date}
      <input
        id="reservation-date"
        class={formClasses.input}
        name="date"
        type="date"
        required
      />
    </label>

    <label class={formClasses.label}>
      {t.reservation.labels.time}
      <select
        id="reservation-time"
        class={formClasses.input}
        name="time"
        required
        data-placeholder={t.reservation.labels.time}
      >
        <option value="" disabled selected>
          {t.reservation.labels.time}
        </option>
        {
          locationOptions
            .find((location) => location.id === defaultLocationId)
            ?.timeSlots.map((timeSlot) => (
              <option value={timeSlot}>{timeSlot}</option>
            ))
        }
      </select>
    </label>
  </div>

  <label class={formClasses.label}>
    {t.reservation.labels.location}
    <select
      id="reservation-location"
      class={formClasses.input}
      name="location"
      required
    >
      {
        locationOptions.map((location) => (
          <option
            value={location.label}
            selected={location.id === defaultLocationId}
            data-time-slots={JSON.stringify(location.timeSlots)}
          >
            {location.label}
          </option>
        ))
      }
    </select>
  </label>

  <label class={formClasses.label}>
    {t.reservation.labels.message}
    <textarea
      class={formClasses.textarea}
      name="message"
      placeholder={t.reservation.placeholders.message}></textarea>
  </label>

  <p class={formClasses.finePrint}>
    {t.reservation.consent}
    <a
      class={formClasses.privacyLink}
      href={privacyPath}
    >
      {t.reservation.privacyLink}
    </a>
  </p>

  {
    captchaEnabled && (
      <div
        class:list={[formClasses.captcha, "h-captcha"]}
        data-captcha="true"
      >
      </div>
    )
  }

  <div class={formClasses.submitRow}>
    <p
      id="reservation-status"
      class={formClasses.status}
      aria-live="polite"
    >
    </p>
    <button
      id="reservation-submit"
      class={formClasses.submitButton}
      type="submit"
    >
      {t.reservation.submit}
    </button>
  </div>

  <p class={formClasses.finePrint}>
    {brand.publicName} - {brand.email} - {brand.whatsapp}
  </p>
</form>

<script>
  import "../scripts/reservationForm";
</script>

{
  captchaEnabled && (
    <script
      is:inline
      src="https://web3forms.com/client/script.js"
      async
      defer
    ></script>
  )
}
