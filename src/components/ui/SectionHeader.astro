---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  containerClass?: string;
  eyebrowClass?: string;
  titleClass?: string;
  introClass?: string;
  headingTag?: "h1" | "h2";
}

const defaultClasses = {
  eyebrow: "text-xs font-semibold uppercase tracking-[0.28em] text-gold",
  title: "mt-4 text-4xl font-semibold leading-tight text-white sm:text-5xl",
  intro: "mt-5 text-lg leading-8 text-paper-soft/82",
};

const {
  eyebrow,
  title,
  intro,
  containerClass,
  eyebrowClass = defaultClasses.eyebrow,
  titleClass = defaultClasses.title,
  introClass = defaultClasses.intro,
  headingTag = "h1",
} = Astro.props;

const HeadingTag = headingTag;
---

<div class={containerClass}>
  {eyebrow && <p class={eyebrowClass}>{eyebrow}</p>}
  <HeadingTag class={titleClass}>{title}</HeadingTag>
  {intro && <p class={introClass}>{intro}</p>}
  <slot />
</div>
