---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  containerClass?: string;
  eyebrowClass?: string;
  titleClass?: string;
  introClass?: string;
  headingTag?: "h1" | "h2";
}

const defaultClasses = {
  eyebrow:
    "max-w-full break-words text-xs font-semibold uppercase leading-5 tracking-normal text-gold",
  title:
    "mt-4 max-w-full break-words text-3xl font-semibold leading-tight text-white min-[360px]:text-4xl sm:text-5xl",
  intro: "mt-5 text-lg leading-8 text-paper-soft/82",
};

const {
  eyebrow,
  title,
  intro,
  containerClass,
  eyebrowClass = defaultClasses.eyebrow,
  titleClass = defaultClasses.title,
  introClass = defaultClasses.intro,
  headingTag = "h1",
} = Astro.props;

const HeadingTag = headingTag;
---

<div class:list={["min-w-0 w-full", containerClass]}>
  {eyebrow && <p class={eyebrowClass}>{eyebrow}</p>}
  <HeadingTag class={titleClass}>{title}</HeadingTag>
  {intro && <p class={introClass}>{intro}</p>}
  <slot />
</div>
