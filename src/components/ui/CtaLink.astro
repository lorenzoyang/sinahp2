---
import type { HTMLAttributes } from "astro/types";

type LinkVariant =
  | "gold"
  | "goldHero"
  | "goldSmall"
  | "whiteOutline"
  | "whiteOutlineStatic"
  | "whiteOutlineHero"
  | "cultureOutline"
  | "lightOutlineSmall"
  | "redSmall";

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href: string;
  variant?: LinkVariant;
  external?: boolean;
}

const {
  href,
  variant = "gold",
  class: className,
  external = false,
  target,
  rel,
  ...attrs
} = Astro.props;

const baseClass =
  "focus-ring inline-flex items-center rounded-md font-semibold";
const variantClass: Record<LinkVariant, string> = {
  gold: "min-h-12 justify-center bg-[#c7a062] px-5 py-3 text-[#15110f]",
  goldHero:
    "min-h-12 justify-center bg-[#c7a062] px-5 py-3 text-base text-[#15110f] transition hover:bg-[#dfbd7d]",
  goldSmall:
    "min-h-11 justify-center bg-[#c7a062] px-4 py-2 text-sm text-[#15110f] transition hover:bg-[#dfbd7d]",
  whiteOutline:
    "min-h-12 justify-center border border-white/18 px-5 py-3 text-white hover:bg-white/10",
  whiteOutlineStatic:
    "min-h-12 justify-center border border-white/18 px-5 py-3 text-white",
  whiteOutlineHero:
    "min-h-12 justify-center border border-white/28 px-5 py-3 text-base text-white transition hover:bg-white/10",
  cultureOutline:
    "min-h-10 border border-[#c7a062] px-4 py-2 text-sm text-[#f7f0e7] transition hover:bg-[#c7a062] hover:text-[#15110f]",
  lightOutlineSmall: "border border-[#c7a062] px-4 py-2 text-sm text-[#15110f]",
  redSmall:
    "bg-[#8f241d] px-4 py-2 text-sm !text-[#f7f0e7] transition hover:bg-[#701b16]",
};
const targetValue = external ? "_blank" : target;
const relValue = external ? "noreferrer" : rel;
---

<a
  href={href}
  class:list={[baseClass, variantClass[variant], className]}
  target={targetValue}
  rel={relValue}
  {...attrs}
>
  <slot />
</a>
