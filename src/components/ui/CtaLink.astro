---
import type { HTMLAttributes } from "astro/types";

type LinkVariant =
  | "gold"
  | "goldHero"
  | "goldSmall"
  | "whiteOutline"
  | "whiteOutlineStatic"
  | "whiteOutlineHero"
  | "cultureOutline"
  | "lightOutlineSmall"
  | "redSmall";

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href: string;
  variant?: LinkVariant;
  external?: boolean;
}

const {
  href,
  variant = "gold",
  class: className,
  external = false,
  target,
  rel,
  ...attrs
} = Astro.props;

const baseClass =
  "focus-ring inline-flex items-center rounded-md font-semibold";
const variantClass: Record<LinkVariant, string> = {
  gold: "min-h-12 justify-center bg-gold px-5 py-3 text-ink",
  goldHero:
    "min-h-12 justify-center bg-gold px-5 py-3 text-base text-ink transition hover:bg-gold-hover",
  goldSmall:
    "min-h-11 justify-center bg-gold px-4 py-2 text-sm text-ink transition hover:bg-gold-hover",
  whiteOutline:
    "min-h-12 justify-center border border-white/18 px-5 py-3 text-white hover:bg-white/10",
  whiteOutlineStatic:
    "min-h-12 justify-center border border-white/18 px-5 py-3 text-white",
  whiteOutlineHero:
    "min-h-12 justify-center border border-white/28 px-5 py-3 text-base text-white transition hover:bg-white/10",
  cultureOutline:
    "min-h-10 border border-gold px-4 py-2 text-sm text-paper transition hover:bg-gold hover:text-ink",
  lightOutlineSmall: "border border-gold px-4 py-2 text-sm text-ink",
  redSmall:
    "bg-lacquer px-4 py-2 text-sm !text-paper transition hover:bg-lacquer-hover",
};
const targetValue = external ? "_blank" : target;
const relValue = external ? "noreferrer" : rel;
---

<a
  href={href}
  class:list={[baseClass, variantClass[variant], className]}
  target={targetValue}
  rel={relValue}
  {...attrs}
>
  <slot />
</a>
