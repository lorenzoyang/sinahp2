---
import { Image } from "astro:assets";
import CtaLink from "../ui/CtaLink.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { getPath, type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import { homeImages } from "../../data/pageImages";
import {
  imageSizes,
  mediaClasses as sharedMediaClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const reservationPath = getPath(locale, "reservation");
const locationsPath = getPath(locale, "locations");
const culturePath = getPath(locale, "culture");
const sectionClasses = {
  hero: "homepage-hero relative overflow-hidden",
  heroInner:
    "relative mx-auto flex min-h-[78svh] max-w-7xl items-end px-4 pb-10 pt-20 sm:min-h-[82svh] sm:px-6 lg:px-8",
};
const mediaClasses = {
  backdrop: "absolute inset-0",
  heroImage: `hero-image-drift ${sharedMediaClasses.absoluteImage}`,
  verticalOverlay: "absolute inset-0 bg-linear-to-b from-ink/46 via-ink/64 to-ink",
  horizontalOverlay:
    "absolute inset-0 bg-linear-to-r from-ink/92 via-ink/56 to-transparent",
};
const layoutClasses = {
  content: "w-full max-w-3xl min-w-0",
  primaryActions: "mt-7 flex w-full min-w-0 flex-col gap-3 sm:flex-row",
  secondaryActions:
    "mt-3 flex w-full min-w-0 flex-col gap-3 sm:flex-row sm:flex-wrap",
};
const headingClasses = {
  title:
    "mt-5 max-w-full break-words text-3xl font-semibold leading-[1.02] text-white min-[360px]:text-4xl sm:text-6xl sm:leading-[0.98] lg:text-7xl",
  intro:
    "mt-5 max-w-full break-words text-base leading-7 text-paper/88 sm:max-w-2xl sm:text-xl sm:leading-8",
};
const actionClasses = {
  heroLink: "w-full sm:w-auto",
};
---

<section class={sectionClasses.hero}>
  <div class={mediaClasses.backdrop}>
    <Image
      src={homeImages.hero}
      alt=""
      class={mediaClasses.heroImage}
      width={imageSizes.fullBleedHero.width}
      widths={imageSizes.fullBleedHero.widths}
      sizes={imageSizes.fullBleedHero.sizes}
      loading="eager"
    />
    <div class={mediaClasses.verticalOverlay}></div>
    <div class={mediaClasses.horizontalOverlay}></div>
  </div>

  <div class={sectionClasses.heroInner}>
    <div class={layoutClasses.content} data-reveal>
      <SectionHeader
        eyebrow={t.home.eyebrow}
        title={t.home.title}
        intro={t.home.intro}
        containerClass={layoutClasses.content}
        titleClass={headingClasses.title}
        introClass={headingClasses.intro}
      >
        <div class={layoutClasses.primaryActions}>
          <CtaLink
            href={reservationPath}
            variant="goldHero"
            class={actionClasses.heroLink}
          >
            {t.cta.reserve}
          </CtaLink>
          <CtaLink
            href={culturePath}
            variant="whiteOutlineHero"
            class={actionClasses.heroLink}
          >
            {t.cta.culture}
          </CtaLink>
        </div>
        <div class={layoutClasses.secondaryActions}>
          <CtaLink
            href={locationsPath}
            variant="whiteOutlineHero"
            class={actionClasses.heroLink}
          >
            {t.cta.whatsappReservation}
          </CtaLink>
          <CtaLink
            href={locationsPath}
            variant="whiteOutlineHero"
            class={actionClasses.heroLink}
          >
            {t.cta.phoneReservation}
          </CtaLink>
          <CtaLink
            href={locationsPath}
            variant="whiteOutlineHero"
            class={actionClasses.heroLink}
          >
            {t.cta.wechatReservation}
          </CtaLink>
        </div>
      </SectionHeader>
    </div>
  </div>
</section>
