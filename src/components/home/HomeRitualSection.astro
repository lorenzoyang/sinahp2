---
import { Image } from "astro:assets";
import SectionHeader from "../ui/SectionHeader.astro";
import { brand, type Locale } from "../../data/site";
import { copy } from "../../data/copy";
import { homeImages } from "../../data/pageImages";
import {
  formatSequenceNumber,
  getStaggerStyle,
} from "../../utils/presentation";
import {
  cardClasses as sharedCardClasses,
  headingClasses,
  imageSizes,
  layoutClasses as sharedLayoutClasses,
  mediaClasses as sharedMediaClasses,
  sectionClasses as sharedSectionClasses,
} from "../../utils/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const sectionClasses = {
  root: sharedSectionClasses.dark,
};
const layoutClasses = {
  content: `${sharedLayoutClasses.container} grid gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-center`,
  body: "contents lg:block",
  heading: "order-1",
  steps: "order-3 grid w-full min-w-0 gap-3 sm:grid-cols-2 lg:mt-8",
};
const cardClasses = {
  dark: `homepage-card ${sharedCardClasses.dark}`,
};
const mediaClasses = {
  ritualFrame:
    "relative aspect-4/3 overflow-hidden rounded-lg border border-white/12 bg-ink-panel shadow-[0_24px_70px_rgba(0,0,0,0.24)]",
  photo: `homepage-photo ${sharedMediaClasses.absoluteImage}`,
};
const textClasses = {
  intro: "mt-4 max-w-2xl text-base leading-7 text-paper-soft/78",
  sequence: "text-sm font-semibold text-gold",
  title: "mt-4 text-lg font-semibold text-white",
  body: "mt-3 text-sm leading-6 text-paper-soft/74",
};
---

<section class={sectionClasses.root}>
  <div class={layoutClasses.content}>
    <div class={layoutClasses.body}>
      <div class={layoutClasses.heading} data-reveal>
        <SectionHeader
          eyebrow={brand.publicName}
          title={t.home.sections.ritualTitle}
          intro={t.home.sections.ritualIntro}
          headingTag="h2"
          containerClass="max-w-3xl"
          eyebrowClass={headingClasses.darkEyebrow}
          titleClass={headingClasses.darkTitle}
          introClass={textClasses.intro}
        />
      </div>
      <div class={layoutClasses.steps}>
        {
          t.home.steps.map(([title, text], index) => (
            <article
              class:list={[cardClasses.dark, "p-5"]}
              data-reveal
              style={getStaggerStyle(index, 0, 90)}
            >
              <span class={textClasses.sequence}>
                {formatSequenceNumber(index)}
              </span>
              <h3 class={textClasses.title}>{title}</h3>
              <p class={textClasses.body}>{text}</p>
            </article>
          ))
        }
      </div>
    </div>
    <div
      class:list={[mediaClasses.ritualFrame, "order-2 lg:order-0"]}
      data-reveal
      style="--reveal-delay:90ms"
    >
      <Image
        src={homeImages.howToEat}
        alt=""
        class={mediaClasses.photo}
        width={imageSizes.splitPanel.width}
        widths={imageSizes.splitPanel.widths}
        sizes={imageSizes.splitPanel.sizes}
        loading="lazy"
      />
    </div>
  </div>
</section>
