---
import CulturePage from "../../components/pages/CulturePage.astro";
import CultureTopicPage from "../../components/pages/CultureTopicPage.astro";
import HomePage from "../../components/pages/HomePage.astro";
import LocationsPage from "../../components/pages/LocationsPage.astro";
import PrivacyPage from "../../components/pages/PrivacyPage.astro";
import ReservationPage from "../../components/pages/ReservationPage.astro";
import SuccessPage from "../../components/pages/SuccessPage.astro";
import {
  getLocalizedStaticPaths,
  type LocalizedRouteProps,
} from "../../data/site";

const pageComponents = {
  home: HomePage,
  culture: CulturePage,
  locations: LocationsPage,
  reservation: ReservationPage,
  success: SuccessPage,
  privacy: PrivacyPage,
};

export function getStaticPaths() {
  return getLocalizedStaticPaths();
}

const { locale, page, topicId } = Astro.props as LocalizedRouteProps;
const PageComponent =
  page === "cultureTopic" ? undefined : pageComponents[page];
---

{
  page === "cultureTopic" && topicId && (
    <CultureTopicPage locale={locale} topicId={topicId} />
  )
}
{PageComponent && <PageComponent locale={locale} />}
