---
import "../styles/global.css";
import {
  brand,
  getPath,
  htmlLang,
  localeFlags,
  localeNames,
  locales,
  primaryNavPages,
  type Locale,
  type PageId,
} from "../data/site";
import { copy } from "../data/copy";

interface Props {
  locale: Locale;
  page: PageId;
  title?: string;
  description?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
}

const { locale, page, title, description, alternatePaths } = Astro.props;
const t = copy[locale];
const pageTitle = title ?? t.meta.homeTitle;
const pageDescription = description ?? t.meta.description;
const navItems = primaryNavPages.map((navPage) => ({
  page: navPage,
  label: t.nav[navPage],
}));
const localeOptions = locales.map((targetLocale) => ({
  locale: targetLocale,
  label: localeNames[targetLocale],
  flag: localeFlags[targetLocale],
  code: targetLocale.toUpperCase(),
  path: alternatePaths?.[targetLocale] ?? getPath(targetLocale, page),
}));
const currentLocaleOption = {
  locale,
  label: localeNames[locale],
  flag: localeFlags[locale],
  code: locale.toUpperCase(),
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="/images/generated/premium-hotpot-hero.png"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a
      href="#main"
      class="focus-ring sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-[#f7f0e7] focus:px-4 focus:py-2 focus:text-[#15110f]"
    >
      Skip to content
    </a>

    <header
      class="sticky top-0 z-40 border-b border-white/10 bg-[#15110f]/88 backdrop-blur-xl"
    >
      <div
        class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
      >
        <a
          href={getPath(locale)}
          class="focus-ring min-w-0 rounded-md"
          aria-label={brand.publicName}
        >
          <span
            class="block text-[0.68rem] uppercase tracking-[0.24em] text-[#c7a062]"
            >{brand.publicName}</span
          >
          <span
            class="mt-0.5 block truncate text-lg font-semibold text-[#f7f0e7]"
            >{brand.chineseName}</span
          >
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
          {
            navItems.map((item) => (
              <a
                href={getPath(locale, item.page)}
                aria-current={page === item.page ? "page" : undefined}
                class="site-nav-link focus-ring rounded-full px-4 py-2 text-sm font-medium transition"
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="flex shrink-0 items-center gap-2">
          <details class="site-locale-menu group relative" data-header-details>
            <summary
              class="site-locale-trigger focus-ring flex h-10 min-w-19 list-none items-center justify-center gap-1.5 rounded-full border px-3 text-sm font-semibold transition marker:hidden"
              aria-label="Language"
              title={currentLocaleOption.label}
            >
              <span class="text-base leading-none" aria-hidden="true">
                {currentLocaleOption.flag}
              </span>
              <span>{currentLocaleOption.code}</span>
            </summary>
            <div
              class="absolute right-0 z-50 mt-3 w-44 rounded-lg border border-white/12 bg-[#1d1714] p-2 shadow-2xl"
            >
              <nav class="grid gap-1" aria-label="Language">
                {
                  localeOptions.map((option) => (
                    <a
                      href={option.path}
                      aria-current={option.locale === locale ? "true" : undefined}
                      class="site-locale-option focus-ring flex min-h-10 items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold transition"
                    >
                      <span class="text-base leading-none" aria-hidden="true">
                        {option.flag}
                      </span>
                      <span class="flex-1">{option.label}</span>
                      <span class="site-locale-code text-xs uppercase">
                        {option.code}
                      </span>
                    </a>
                  ))
                }
              </nav>
            </div>
          </details>

          <details class="group relative md:hidden" data-header-details>
            <summary
              class="focus-ring list-none rounded-full border border-white/15 px-4 py-2 text-sm font-semibold text-[#f7f0e7] marker:hidden"
            >
              {t.nav.menu}
            </summary>
            <div
              class="absolute right-0 z-50 mt-3 w-[min(18rem,calc(100vw-2rem))] rounded-lg border border-white/12 bg-[#1d1714] p-3 shadow-2xl"
            >
              <nav class="grid gap-1" aria-label="Mobile primary">
                {
                  navItems.map((item) => (
                    <a
                      href={getPath(locale, item.page)}
                      aria-current={page === item.page ? "page" : undefined}
                      class="site-nav-link focus-ring rounded-md px-3 py-2 text-sm font-medium"
                    >
                      {item.label}
                    </a>
                  ))
                }
              </nav>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="page-band bg-[#120f0d]">
      <div
        class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1.2fr_1fr] lg:px-8"
      >
        <div>
          <p class="text-[0.72rem] uppercase tracking-[0.24em] text-[#c7a062]">
            {brand.publicName}
          </p>
          <p class="mt-2 text-2xl font-semibold text-white">
            {brand.chineseName}
          </p>
          <p class="mt-4 max-w-xl text-sm leading-6 text-[#efe3d5]/72">
            {t.meta.description}
          </p>
        </div>
        <div class="grid gap-4 text-sm text-[#efe3d5]/80 sm:grid-cols-2">
          <div>
            <p class="font-semibold text-white">Contact</p>
            <a
              class="focus-ring mt-2 block rounded-sm hover:text-white"
              href={`mailto:${brand.email}`}>{brand.email}</a
            >
            <a
              class="focus-ring mt-1 block rounded-sm hover:text-white"
              href={brand.whatsappHref}>{brand.whatsapp}</a
            >
          </div>
          <div>
            <p class="font-semibold text-white">Social</p>
            <a
              class="focus-ring mt-2 block rounded-sm hover:text-white"
              href={brand.instagram}
              target="_blank"
              rel="noreferrer">Instagram</a
            >
            <a
              class="focus-ring mt-1 block rounded-sm hover:text-white"
              href={brand.facebook}
              target="_blank"
              rel="noreferrer">Facebook</a
            >
            <a
              class="focus-ring mt-1 block rounded-sm hover:text-white"
              href={getPath(locale, "privacy")}>{t.nav.privacy}</a
            >
          </div>
        </div>
      </div>
    </footer>
    <script>
      document
        .querySelectorAll<HTMLDetailsElement>("[data-header-details]")
        .forEach((details, _index, allDetails) => {
          details.addEventListener("toggle", () => {
            if (!details.open) {
              return;
            }

            allDetails.forEach((otherDetails) => {
              if (otherDetails !== details) {
                otherDetails.open = false;
              }
            });
          });
        });
    </script>
  </body>
</html>
