---
import "../styles/global.css";
import CookieConsentBanner from "../components/CookieConsentBanner.astro";
import GoogleAdsTag from "../components/GoogleAdsTag.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import {
  brand,
  getPath,
  htmlLang,
  locales,
  type Locale,
  type PageId,
} from "../data/site";
import { copy } from "../data/copy";
import {
  defaultSocialImageAlt,
  defaultSocialImageUrl,
  getCanonicalUrl,
  getHreflangLinks,
  getPageSeoMeta,
  getPageAlternatePaths,
  getWebsiteStructuredData,
  openGraphLocales,
  toAbsoluteUrl,
} from "../data/seo";

interface Props {
  locale: Locale;
  page: PageId;
  title?: string;
  description?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
  extraStructuredData?: readonly Record<string, unknown>[];
}

const {
  locale,
  page,
  title,
  description,
  alternatePaths,
  noindex = false,
  socialImage,
  socialImageAlt,
  extraStructuredData = [],
} = Astro.props;
const t = copy[locale];
const layoutLabels = t.layout;
const seoMeta = getPageSeoMeta(locale, page);
const pageTitle = title ?? seoMeta?.title ?? t.meta.homeTitle;
const pageDescription = description ?? seoMeta?.description ?? t.meta.description;
const pageAlternatePaths = {
  ...getPageAlternatePaths(page),
  ...alternatePaths,
};
const isIndexable = !noindex;
const canonicalPath = pageAlternatePaths[locale] ?? getPath(locale, page);
const canonicalUrl = getCanonicalUrl(canonicalPath);
const hreflangLinks = isIndexable ? getHreflangLinks(pageAlternatePaths) : [];
const socialImageUrl = toAbsoluteUrl(socialImage ?? defaultSocialImageUrl);
const socialImageAltText = socialImageAlt ?? defaultSocialImageAlt;
const structuredData = JSON.stringify(getWebsiteStructuredData());
const extraStructuredDataJson = extraStructuredData.map((entry) =>
  JSON.stringify(entry),
);
const a11yClasses = {
  skipLink:
    "focus-ring sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-paper focus:px-4 focus:py-2 focus:text-ink",
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {isIndexable && <link rel="canonical" href={canonicalUrl} />}
    {
      hreflangLinks.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={brand.publicName} />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {
      locales
        .filter((targetLocale) => targetLocale !== locale)
        .map((targetLocale) => (
          <meta
            property="og:locale:alternate"
            content={openGraphLocales[targetLocale]}
          />
        ))
    }
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAltText} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
    <GoogleAdsTag />
    <script type="application/ld+json" is:inline set:html={structuredData} />
    {
      extraStructuredDataJson.map((entry) => (
        <script type="application/ld+json" is:inline set:html={entry} />
      ))
    }
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body data-page={page}>
    <a href="#main" class={a11yClasses.skipLink}>
      {layoutLabels.skipToContent}
    </a>

    <SiteHeader locale={locale} page={page} alternatePaths={alternatePaths} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter locale={locale} />
    <CookieConsentBanner
      labels={t.cookieConsent}
      privacyHref={getPath(locale, "privacy")}
    />
    <script>
      import "../scripts/googleAdsConversions";
      import "../scripts/headerMenus";
    </script>
  </body>
</html>
