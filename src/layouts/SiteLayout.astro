---
import "../styles/global.css";
import ArchiveNotice from "../components/ArchiveNotice.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import {
  brand,
  getPath,
  htmlLang,
  locales,
  type Locale,
  type PageId,
} from "../data/site";
import { copy } from "../data/copy";
import {
  defaultSocialImageAlt,
  defaultSocialImageUrl,
  getCanonicalUrl,
  getPageSeoMeta,
  getPageAlternatePaths,
  openGraphLocales,
  toAbsoluteUrl,
} from "../data/seo";

interface Props {
  locale: Locale;
  page: PageId;
  title?: string;
  description?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  locale,
  page,
  title,
  description,
  alternatePaths,
  socialImage,
  socialImageAlt,
} = Astro.props;
const t = copy[locale];
const layoutLabels = t.layout;
const seoMeta = getPageSeoMeta(locale, page);
const pageTitle = `${title ?? seoMeta?.title ?? t.meta.homeTitle} | ${t.archive.label}`;
const pageDescription = `${t.archive.label}. ${description ?? seoMeta?.description ?? t.meta.description}`;
const pageAlternatePaths = {
  ...getPageAlternatePaths(page),
  ...alternatePaths,
};
const canonicalPath = pageAlternatePaths[locale] ?? getPath(locale, page);
const canonicalUrl = getCanonicalUrl(canonicalPath);
const socialImageUrl = toAbsoluteUrl(socialImage ?? defaultSocialImageUrl);
const socialImageAltText = socialImageAlt ?? defaultSocialImageAlt;
const a11yClasses = {
  skipLink:
    "focus-ring sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-paper focus:px-4 focus:py-2 focus:text-ink",
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={`${brand.publicName} | ${t.archive.label}`} />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {
      locales
        .filter((targetLocale) => targetLocale !== locale)
        .map((targetLocale) => (
          <meta
            property="og:locale:alternate"
            content={openGraphLocales[targetLocale]}
          />
        ))
    }
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAltText} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body data-page={page}>
    <a href="#main" class={a11yClasses.skipLink}>
      {layoutLabels.skipToContent}
    </a>

    <ArchiveNotice locale={locale} />
    <SiteHeader locale={locale} page={page} alternatePaths={alternatePaths} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter locale={locale} />
    <script>
      import "../scripts/headerMenus";
    </script>
  </body>
</html>
