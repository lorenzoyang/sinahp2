---
import "../styles/global.css";
import {
  brand,
  getPath,
  htmlLang,
  localeFlags,
  localeNames,
  locales,
  primaryNavPages,
  type Locale,
  type PageId,
} from "../data/site";
import { copy } from "../data/copy";

interface Props {
  locale: Locale;
  page: PageId;
  title?: string;
  description?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
}

const { locale, page, title, description, alternatePaths } = Astro.props;
const t = copy[locale];
const layoutLabels = t.layout;
const pageTitle = title ?? t.meta.homeTitle;
const pageDescription = description ?? t.meta.description;
const navItems = primaryNavPages.map((navPage) => ({
  page: navPage,
  label: t.nav[navPage],
}));
const localeOptions = locales.map((targetLocale) => ({
  locale: targetLocale,
  label: localeNames[targetLocale],
  flag: localeFlags[targetLocale],
  code: targetLocale.toUpperCase(),
  path: alternatePaths?.[targetLocale] ?? getPath(targetLocale, page),
}));
const currentLocaleOption =
  localeOptions.find((option) => option.locale === locale) ?? localeOptions[0];
const layoutClasses = {
  skipLink:
    "focus-ring sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-paper focus:px-4 focus:py-2 focus:text-ink",
  header: "sticky top-0 z-40 border-b border-white/10 bg-ink/88 backdrop-blur-xl",
  headerInner:
    "mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8",
  brandLink: "focus-ring min-w-0 rounded-md",
  brandEyebrow: "block text-[0.68rem] uppercase tracking-[0.24em] text-gold",
  brandName: "mt-0.5 block truncate text-lg font-semibold text-paper",
  desktopNav: "hidden items-center gap-1 md:flex",
  navLink:
    "site-nav-link focus-ring rounded-full px-4 py-2 text-sm font-medium transition",
  headerActions: "flex shrink-0 items-center gap-2",
  localeMenu: "site-locale-menu group relative",
  localeTrigger:
    "site-locale-trigger focus-ring flex h-10 min-w-19 list-none items-center justify-center gap-1.5 rounded-full border px-3 text-sm font-semibold transition marker:hidden",
  localeFlag: "text-base leading-none",
  localePanel:
    "absolute right-0 z-50 mt-3 w-44 rounded-lg border border-white/12 bg-ink-panel p-2 shadow-2xl",
  localeNav: "grid gap-1",
  localeOption:
    "site-locale-option focus-ring flex min-h-10 items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold transition",
  localeLabel: "flex-1",
  localeCode: "site-locale-code text-xs uppercase",
  mobileMenu: "group relative md:hidden",
  mobileMenuTrigger:
    "focus-ring list-none rounded-full border border-white/15 px-4 py-2 text-sm font-semibold text-paper marker:hidden",
  mobilePanel:
    "absolute right-0 z-50 mt-3 w-[min(18rem,calc(100vw-2rem))] rounded-lg border border-white/12 bg-ink-panel p-3 shadow-2xl",
  mobileNavLink: "site-nav-link focus-ring rounded-md px-3 py-2 text-sm font-medium",
  footer: "page-band bg-ink-footer",
  footerInner:
    "mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1.2fr_1fr] lg:px-8",
  footerEyebrow: "text-[0.72rem] uppercase tracking-[0.24em] text-gold",
  footerBrand: "mt-2 text-2xl font-semibold text-white",
  footerDescription: "mt-4 max-w-xl text-sm leading-6 text-paper-soft/72",
  footerLinksGrid: "grid gap-4 text-sm text-paper-soft/80 sm:grid-cols-2",
  footerHeading: "font-semibold text-white",
  footerLink: "focus-ring mt-2 block rounded-sm hover:text-white",
  footerLinkTight: "focus-ring mt-1 block rounded-sm hover:text-white",
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="/images/generated/premium-hotpot-hero.png"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body data-page={page}>
    <a href="#main" class={layoutClasses.skipLink}>
      {layoutLabels.skipToContent}
    </a>

    <header class={layoutClasses.header}>
      <div class={layoutClasses.headerInner}>
        <a
          href={getPath(locale)}
          class={layoutClasses.brandLink}
          aria-label={brand.publicName}
        >
          <span class={layoutClasses.brandEyebrow}>{brand.publicName}</span>
          <span class={layoutClasses.brandName}>{brand.chineseName}</span>
        </a>

        <nav class={layoutClasses.desktopNav} aria-label="Primary">
          {
            navItems.map((item) => (
              <a
                href={getPath(locale, item.page)}
                aria-current={page === item.page ? "page" : undefined}
                class={layoutClasses.navLink}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class={layoutClasses.headerActions}>
          <details class={layoutClasses.localeMenu} data-header-details>
            <summary
              class={layoutClasses.localeTrigger}
              aria-label="Language"
              title={currentLocaleOption.label}
            >
              <span class={layoutClasses.localeFlag} aria-hidden="true">
                {currentLocaleOption.flag}
              </span>
              <span>{currentLocaleOption.code}</span>
            </summary>
            <div class={layoutClasses.localePanel}>
              <nav class={layoutClasses.localeNav} aria-label="Language">
                {
                  localeOptions.map((option) => (
                    <a
                      href={option.path}
                      aria-current={option.locale === locale ? "true" : undefined}
                      aria-label={option.label}
                      class={layoutClasses.localeOption}
                    >
                      <span class={layoutClasses.localeFlag} aria-hidden="true">
                        {option.flag}
                      </span>
                      <span class={layoutClasses.localeLabel}>{option.label}</span>
                      <span class={layoutClasses.localeCode}>
                        {option.code}
                      </span>
                    </a>
                  ))
                }
              </nav>
            </div>
          </details>

          <details class={layoutClasses.mobileMenu} data-header-details>
            <summary class={layoutClasses.mobileMenuTrigger}>
              {t.nav.menu}
            </summary>
            <div class={layoutClasses.mobilePanel}>
              <nav class={layoutClasses.localeNav} aria-label="Mobile primary">
                {
                  navItems.map((item) => (
                    <a
                      href={getPath(locale, item.page)}
                      aria-current={page === item.page ? "page" : undefined}
                      aria-label={item.label}
                      class={layoutClasses.mobileNavLink}
                    >
                      {item.label}
                    </a>
                  ))
                }
              </nav>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class={layoutClasses.footer}>
      <div class={layoutClasses.footerInner}>
        <div>
          <p class={layoutClasses.footerEyebrow}>
            {brand.publicName}
          </p>
          <p class={layoutClasses.footerBrand}>
            {brand.chineseName}
          </p>
          <p class={layoutClasses.footerDescription}>
            {t.meta.description}
          </p>
        </div>
        <div class={layoutClasses.footerLinksGrid}>
          <div>
            <p class={layoutClasses.footerHeading}>{layoutLabels.contact}</p>
            <a
              class={layoutClasses.footerLink}
              href={`mailto:${brand.email}`}>{brand.email}</a
            >
            <a
              class={layoutClasses.footerLinkTight}
              href={brand.whatsappHref}>{brand.whatsapp}</a
            >
          </div>
          <div>
            <p class={layoutClasses.footerHeading}>{layoutLabels.social}</p>
            <a
              class={layoutClasses.footerLink}
              href={brand.instagram}
              target="_blank"
              rel="noreferrer">Instagram</a
            >
            <a
              class={layoutClasses.footerLinkTight}
              href={brand.facebook}
              target="_blank"
              rel="noreferrer">Facebook</a
            >
            <a
              class={layoutClasses.footerLinkTight}
              href={getPath(locale, "privacy")}>{t.nav.privacy}</a
            >
          </div>
        </div>
      </div>
    </footer>
    <script>
      import "../scripts/headerMenus";
    </script>
  </body>
</html>
